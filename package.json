{
  "name": "d2-worx",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.15.0"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,mjs,cjs,json,svelte,html,css,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,cjs,json,svelte,html,css,md,yaml,yml}\"",
    "test": "vitest run",
    "test:contracts": "pnpm --filter @d2/contract-tests test",
    "type-check:test": "pnpm -r run type-check:test",
    "codegen": "pnpm --filter ts-codegen exec tsx src/orchestrator.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.0",
    "@vitest/coverage-v8": "4.0.18",
    "eslint": "10.0.2",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.4.0",
    "prettier": "3.8.1",
    "prettier-plugin-svelte": "3.4.0",
    "prettier-plugin-tailwindcss": "0.6.14",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vitest": "4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@bufbuild/buf"
    ]
  }
}
