# Operator-local upstream-rejection memory written by `pnpm geo:approve`.
# Canonical path is contracts/geo/.upstream-rejections.json.
contracts/geo/.upstream-rejections.json

# Per-deliverable workflow journals — append-only working memory for the
# audit-loop process. Lives locally during a deliverable. At SHIP time the
# root README is COPIED out as a snapshot to docs/dev/deliverables/<name>.md
# (committed); the per-step journals stay here, gitignored + local-only. The
# workflow does NOT auto-delete them; the user removes them manually whenever
# they want. See docs/dev/workflow.md.
docs/wip/

# Local tool settings (machine-specific)
.claude/*
!.claude/settings.json
!.claude/agents
!.claude/hooks
!.claude/skills

# Coverage
/Coverage
nul

# Playwright MCP screenshots
/screenshots/
**/screenshots/
.playwright-mcp/
/playwright-report/
**/playwright-report/

# Microsoft.Extensions.Logging.Generators emits all [LoggerMessage] partial
# classes into a single LoggerMessage.g.cs file with non-deterministic
# cross-class ordering (same source, every build = different blob hash).
# The splitter tool (tools/loggermessage-splitter, wired via
# server/shared/dotnet/Directory.Build.targets) parses this single file into
# per-class deterministic LoggerMessage.{Ns}.{Class}.g.cs files — those ARE
# tracked so PR reviewers still see codegen diffs.
**/Generated/Microsoft.Extensions.Logging.Generators/Microsoft.Extensions.Logging.Generators.LoggerMessageGenerator/LoggerMessage.g.cs

# System.Text.RegularExpressions source-generator output. A [GeneratedRegex]
# partial method's emitted engine is a build artifact, not a reviewable spec —
# no committed RegexGenerator.g.cs exists in the tree. A project that combines
# [GeneratedRegex] with EmitCompilerGeneratedFiles=true (to commit OTHER
# generators' output, e.g. the error-codes SrcGen) would otherwise emit this
# file to disk; keep it untracked.
**/Generated/System.Text.RegularExpressions.Generator/**

# Generated by some local tools like Grok Build
mcps/**
# TypeSpec spike harness (SC1 + Spikes A/C/B) — throwaway de-risking proofs for
# the Operation Contract IDL (ADR-0021). Kept locally as reference/example files,
# NEVER committed: the whole dir is ignored so new spike artifacts (the .NET
# projects, generated wiring, extra .tsp/.mjs the spikes add) can't be staged by
# accident. Durable record = the design-pass doc + the productionized package.
tools/typespec-spike/
# C# in-memory test-host spike for the TypeSpec emitter harness de-risk.
# Throwaway proof-of-concept; the committed harness is built in a later step.
server/shared/typescript/typespec-emitters/spike-csharp/

# api-extractor transient working copy: the versioning engine commits each
# package's API report under etc/<pkg>.api.md (the baseline) and lets
# api-extractor write its freshly-generated report to temp/ for the diff.
# The temp/ copy is regenerated every run — keep it untracked.
server/shared/typescript/**/temp/
