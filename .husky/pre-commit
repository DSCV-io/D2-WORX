# Block any commit whose staged Prettier-handled files are not Prettier-clean.
# Generated files are excluded by .prettierignore (e.g. **/*.g.ts, Generated/).
# Remediation on failure: run `pnpm format` (or `prettier --write <files>`),
# re-stage, and commit again.
#
# IMPORTANT: do NOT exit early when $staged is empty — .NET-only commits still
# must run fingerprint-currency + PublicAPI.Shipped empty-check below.

staged=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '\.(ts|js|mjs|cjs|json|svelte|html|css|yaml|yml)$' || true)

if [ -n "$staged" ]; then
  # -n 40 chunks the file list across multiple prettier invocations so large
  # commits stay under the Windows command-line length limit (xargs exits
  # non-zero if ANY chunk fails, so the gate still trips on a dirty file).
  # shellcheck disable=SC2086
  if ! printf '%s\n' "$staged" | xargs -n 40 pnpm exec prettier --check; then
    echo ""
    echo "  ✖  Commit rejected: staged files are not Prettier-clean."
    echo ""
    echo "     Run:  pnpm format          (formats the whole repo)"
    echo "       or:  pnpm exec prettier --write <files>"
    echo "     then re-stage and commit again."
    echo ""
    exit 1
  fi
fi

# Block any commit where a consumable package's source changed without
# re-seeding its .release-fingerprint baseline.
# Remediation on failure: run the seed scripts (printed in the error message),
# re-stage the updated baseline files, and commit again.

if ! pnpm --filter release-runner exec tsx src/fingerprint-currency-cli.ts; then
  echo ""
  echo "  ✖  Commit rejected: one or more baseline fingerprints are stale."
  echo "     See the table above for affected packages and remediation steps."
  echo ""
  exit 1
fi

# Block commits that leave a consumable's PublicAPI.Shipped.txt header-only while
# HEAD still has a real surface — the failed-seed mid-wipe signature. Currency
# alone can miss empty+recomposd fingerprints; this is the hard empty-Shipped gate.
# Always run (including .NET-only commits with zero Prettier-staged files).
if ! node tools/scripts/check-publicapi-shipped.mjs; then
  echo ""
  echo "  ✖  Commit rejected: PublicAPI.Shipped.txt empty vs non-empty HEAD."
  echo "     Failure wipe → git checkout HEAD -- …/PublicAPI.Shipped.txt"
  echo "     Intentional N→0 API → seed --allow-empty Pkg, then:"
  echo "       SEED_ALLOW_EMPTY=Pkg git commit ..."
  echo "     Package deletion → remove .csproj + baselines together."
  echo ""
  exit 1
fi

exit 0
