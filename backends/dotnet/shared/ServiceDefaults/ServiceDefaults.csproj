<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>D2.Shared.ServiceDefaults</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Tests" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.3.0" />
        <!--
          Surgical OTel vulnerability override. The 1.15.0 series has three known
          moderate-severity advisories:
            GHSA-g94r-2vxg-569j   on OpenTelemetry.Api
            GHSA-mr8r-92fq-pj8p   on OpenTelemetry.Exporter.OpenTelemetryProtocol
            GHSA-q834-8qmm-v933   on OpenTelemetry.Exporter.OpenTelemetryProtocol
          Both directly-affected packages have a 1.15.3 patch (released 2026-04-21).
          OpenTelemetry.Api is added as a direct ref to override the transitive
          version pulled by the Instrumentation.* packages (which still ship the
          1.15.0 line). Re-evaluate when the Instrumentation.* packages catch up
          to 1.15.3 — at that point the direct OpenTelemetry.Api ref can be
          dropped and the Instrumentation versions bumped together.
        -->
        <PackageReference Include="OpenTelemetry.Api" Version="1.15.3" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
        <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.15.0-beta.1" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.GrpcNetClient" Version="1.15.0-beta.1" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.15.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Process" Version="1.15.0-beta.1" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.0" />
        <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
        <PackageReference Include="Serilog.Enrichers.ClientInfo" Version="2.9.0" />
        <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
        <PackageReference Include="Serilog.Enrichers.Span" Version="3.1.0" />

    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Utilities\Utilities.csproj" />
    </ItemGroup>

</Project>
