        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>D2.Geo.Infra</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <Folder Include="Messaging\Handlers\Sub\" />
      <Folder Include="Repository\Handlers\D\" />
      <Folder Include="Repository\Handlers\U\" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\..\shared\Implementations\Caching\Distributed\DistributedCache.Redis\DistributedCache.Redis.csproj" />
      <ProjectReference Include="..\..\..\shared\Implementations\Caching\InMemory\InMemoryCache.Default\InMemoryCache.Default.csproj" />
      <ProjectReference Include="..\..\..\shared\Implementations\Messaging\Messaging.RabbitMQ\Messaging.RabbitMQ.csproj" />
      <ProjectReference Include="..\..\..\shared\protos\_gen\Protos.DotNet\Protos.DotNet.csproj" />
      <ProjectReference Include="..\Geo.Client\Geo.Client.csproj" />
      <ProjectReference Include="..\..\..\shared\Implementations\Repository\Batch\Batch.Pg\Batch.Pg.csproj" />
      <ProjectReference Include="..\..\..\shared\Implementations\Repository\Errors\Errors.Pg\Errors.Pg.csproj" />
      <ProjectReference Include="..\..\..\shared\Implementations\Repository\Transactions\Transactions.Pg\Transactions.Pg.csproj" />
      <ProjectReference Include="..\Geo.App\Geo.App.csproj" />
      <ProjectReference Include="..\Geo.Domain\Geo.Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="IPinfo" Version="3.3.0" />
      <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
      <!--
        Transitive vulnerability override: EF Core 10's tooling chain pulls
        System.Security.Cryptography.Xml 9.0.0 transitively, which has
        GHSA-37gx-xxp4-5rgx and GHSA-w3x6-4m5h-cxqf (both High severity).
        Pinning the latest patched 10.0.7 (released 2026-04-21) at the same
        level as EF Core overrides the transitive. Re-evaluate when EF Core
        ships a version that pulls a non-vulnerable transitive on its own.
      -->
      <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.7" />
    </ItemGroup>

</Project>
