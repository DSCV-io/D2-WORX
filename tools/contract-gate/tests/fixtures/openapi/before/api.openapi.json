{
  "openapi": "3.0.0",
  "info": { "title": "Test API", "version": "1.0" },
  "paths": {
    "/v1/report": {
      "get": {
        "operationId": "getReport",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReportOutput" }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reportId": { "type": "string" }
                },
                "required": ["reportId"]
              }
            }
          }
        }
      }
    },
    "/v1/export": {
      "post": {
        "operationId": "exportReport",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ExportOutput" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ReportOutput": {
        "type": "object",
        "required": ["body", "status"],
        "properties": {
          "body": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["draft", "published", "archived"]
          }
        }
      },
      "ExportOutput": {
        "type": "object",
        "required": ["location"],
        "properties": {
          "location": { "type": "string" }
        }
      }
    }
  }
}
