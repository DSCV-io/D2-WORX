<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Stand-alone console tool that splits the single LoggerMessage.g.cs blob
    emitted by Microsoft.Extensions.Logging.Generators into one deterministic
    per-class file under the same generated-files directory.

    Background: Microsoft.Extensions.Logging.Generators
    (v10.0.14.21808) emits multiple `namespace X { partial class Y { ... } }`
    blocks into a single LoggerMessage.g.cs file with non-deterministic
    cross-class ordering — same source, three consecutive builds produce three
    different blob hashes. Because EmitCompilerGeneratedFiles=true tracks the
    Generated/ tree in git for PR-review visibility, this non-determinism causes
    constant churn (every clean build looks like a diff).

    This tool is run as an AfterTargets="Compile" step by every csproj that
    consumes Microsoft.Extensions.Logging.Generators (wired in
    Directory.Build.targets). After codegen has emitted the combined
    LoggerMessage.g.cs, the tool parses the file into one deterministic
    `LoggerMessage.{NamespaceLastSegment}.{ClassName}.g.cs` file per partial
    class. The combined file itself is gitignored; only the per-class split
    files are committed.

    NOT registered in D2.slnx — this is a stand-alone tool, not part of
    the framework solution build graph. Invoked directly via `dotnet run`.

    See ./README.md for usage + design notes.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>D2.Tools.LoggerMessageSplitter</RootNamespace>
    <AssemblyName>D2.Tools.LoggerMessageSplitter</AssemblyName>
    <!--
      Stand-alone tool — does not participate in the framework solution.
      Suppress build-gate severity escalation here (StyleCop / XML docs aren't
      consumed by anything that ships).
    -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      Build-time output goes to bin/. The tool's binary is invoked via
      `dotnet run` from the MSBuild Exec step; we don't restore SDK analyzers
      that the rest of the solution uses.
    -->
  </PropertyGroup>

  <!-- Stand-alone public tool: strip monorepo StyleCop (not a product/library pack surface). -->
  <ItemGroup>
    <PackageReference Remove="StyleCop.Analyzers" />
    <AdditionalFiles Remove="$(D2RepoRoot)stylecop.json" />
  </ItemGroup>
</Project>

