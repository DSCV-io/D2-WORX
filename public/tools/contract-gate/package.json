  },
  "dependencies": {
    "@dcsv-io/d2-typespec-emitters": "workspace:*",
    "@dcsv-io/d2-utilities": "workspace:*"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.65.0",
    "@types/node": "24.10.0",
    "@vitest/coverage-v8": "4.0.18",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
