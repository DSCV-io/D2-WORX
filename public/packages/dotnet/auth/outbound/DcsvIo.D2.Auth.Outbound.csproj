<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DcsvIo.D2.Auth.Outbound</RootNamespace>
    <!--
      Emit the SrcGen-emitted OutboundTelemetryTags.g.cs (driven by the
      telemetry/tags-source-gen analyzer wired below) plus the framework
      LoggerMessage.g.cs to <project-dir>/Generated/. The directory is tracked
      in git so PR reviewers see codegen diffs without a local build.
    -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The SourceGen pipeline feeds the in-memory compiler with the same content
      that lands on disk under Generated/. Without this Remove, the SDK-default
      <Compile Include="**/*.cs" /> glob picks up the on-disk copy and the build
      fails with duplicate-definition errors (CS0101 / CS0111). See:
      https://learn.microsoft.com/dotnet/core/project-sdk/msbuild-props#compilergeneratedfilesoutputpath
    -->
    <Compile Remove="$(CompilerGeneratedFilesOutputPath)\**\*.cs" />
  </ItemGroup>

  <!--
    Outbound auth runtime — the forward-unchanged transaction-token rail
    (.AddD2ForwardedJwt() per-channel opt-in + ForwardedJwtCallCredentials, which
    replays the inbound request's forwarded JWT on each outbound gRPC hop via the
    framework-free IAmbientRequestScopeAccessor port) + the workload mutual-TLS
    leaf presentation (.AddD2WorkloadCertificate()) + token-exchange (RFC 8693,
    the boundary-mint + exception tool).

    This lib stays framework-free (plain Microsoft.NET.Sdk, gRPC CLIENT factory
    only): the forwarding credential reaches the request-scoped holder through the
    IAmbientRequestScopeAccessor PORT (declared in DcsvIo.D2.Auth.Abstractions,
    already referenced here), whose IHttpContextAccessor-backed adapter lives in
    DcsvIo.D2.Auth.Http — so no FrameworkReference is needed here, and no
    auth/http → auth/outbound ProjectReference edge is needed there (both sides
    share the port via the abstractions slice).

    Discovery is OIDC-canonical: D2_AUTH_ISSUER → /.well-known/openid-configuration →
    token_endpoint via Microsoft.IdentityModel.Protocols.OpenIdConnect's
    ConfigurationManager<OpenIdConnectConfiguration>.
  -->

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="NodaTime" />
  </ItemGroup>

  <ItemGroup>
    <!--
      auth-abstractions — Audiences (codegen'd const URLs), JwtClaimTypes (claim name
      constants codegen'd from contracts/jwt-claims/jwt-claims.spec.json).
      Outbound-side audience targeting flows through the Audiences.* constants.
      HTTP request-header constants live in DcsvIo.D2.Headers.Http.
    -->
    <ProjectReference Include="..\abstractions\DcsvIo.D2.Auth.Abstractions.csproj" />
    <!--
      auth-context-abstractions / context\abstractions — for IRequestContext +
      MutableRequestContext.FromJwtPayloadNoValidation (used by TokenExchangeClient
      to extract d2_session_id from the inbound subject token for cache keying).
    -->
    <ProjectReference Include="..\context-abstractions\DcsvIo.D2.AuthContext.Abstractions.csproj" />
    <ProjectReference Include="..\..\context\abstractions\DcsvIo.D2.Context.Abstractions.csproj" />
    <!--
      caching-abstractions — TokenExchangeCache writes through the shared ILocalCache
      singleton with a 'tokenexchange:' key prefix. Backplane subscription drives
      session-revoked invalidation.
    -->
    <ProjectReference Include="..\..\caching\abstractions\DcsvIo.D2.Caching.Abstractions.csproj" />
    <!--
      resilience — the token-exchange client (HttpTokenExchangeClient) composes a
      CircuitBreaker<FetchResult> + Singleflight from this lib directly around its
      fetch path. The named HttpClient provides only the transport + its Timeout.
      No retry layer: a transient failure on the token-exchange path fails one user
      request acceptably. The breaker (5 failures → 30 s open) is the real
      resilience win — it stops hammering a down Edge.
    -->
    <ProjectReference Include="..\..\resilience\DcsvIo.D2.Resilience.csproj" />
    <ProjectReference Include="..\..\result\core\DcsvIo.D2.Result.csproj" />
    <ProjectReference Include="..\..\i18n\abstractions\DcsvIo.D2.I18n.Abstractions.csproj" />
    <ProjectReference Include="..\..\utilities\DcsvIo.D2.Utilities.csproj" />
    <!--
      headers-grpc — codegen-emitted gRPC metadata-key constants
      (GrpcHeaders.AUTHORIZATION etc.). Consumed by
      ForwardedJwtCallCredentials when attaching the forwarded transaction-token
      Bearer to outbound RPCs. Single spec-driven catalog shared with
      the TS-side @dcsv-io/d2-grpc-* packages so wire-protocol header names are
      byte-identical across .NET and Node.
    -->
    <ProjectReference Include="..\..\headers\grpc\DcsvIo.D2.Headers.Grpc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Telemetry-tags SrcGen — single-targets per the spec's consumingAssembly
      field. Emits OutboundTelemetryTags.g.cs into this assembly. Spec file
      is shared with DcsvIo.D2.Auth's wiring; SrcGen reads it once per
      compilation tick.
    -->
    <ProjectReference Include="..\..\telemetry\tags-source-gen\DcsvIo.D2.Telemetry.Tags.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="$(D2PublicContractsRoot)telemetry\telemetry.spec.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DcsvIo.D2.Tests" />
  </ItemGroup>

  <!-- Publish metadata (per-package semver + NuGet identity). -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <PackageId>DcsvIo.D2.Auth.Outbound</PackageId>
    <Description>Caller-side outbound auth for D2-WORX cross-process calls — forwarded transaction tokens, mTLS workload certificates, and RFC 8693 token exchange.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
