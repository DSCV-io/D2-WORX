<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>DcsvIo.D2.ServiceDefaults</RootNamespace>
    <!--
      Sdk.Web defaults OutputType to Exe (intended for runnable web apps);
      explicit Library override since this is a shared library, NOT an app
      entry point. Sdk.Web is preferred over plain Sdk because it brings the
      AspNetCore framework reference automatically — every public surface in
      this lib touches AspNetCore types (IApplicationBuilder for the
      pipeline aggregator, IEndpointRouteBuilder for the endpoint aggregator,
      WebApplication for the RunD2ServiceAsync re-export, IServiceCollection
      for the DI aggregator). Mirrors sibling DcsvIo.D2.AspNetCore +
      DcsvIo.D2.Logging + DcsvIo.D2.Telemetry csproj.
    -->
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <!--
    DcsvIo.D2.ServiceDefaults — pure thin aggregator. ZERO logic. Owns four
    public extension methods (AddD2ServiceDefaults, UseD2DefaultPipeline,
    MapD2DefaultEndpoints, RunD2ServiceAsync) that wire every prior shared
    lib into a single composition surface, so per-service Program.cs shrinks
    from ~60-150 lines of Serilog / OTel / health / CORS / ProblemDetails /
    startup-wrapper boilerplate to ~10-15 lines of service-specific
    declarations. Every behavior is owned by a logic-bearing prior-step lib
    — this csproj has no internal classes, no middleware impls, no helpers.

    Project references (the canonical 10):
      • DcsvIo.D2.Logging                 — Serilog + redaction + request logging
      • DcsvIo.D2.Telemetry               — OTel SDK + exporters + Prometheus endpoint
      • DcsvIo.D2.AspNetCore              — Security headers, CORS, ProblemDetails,
                                            health checks, infrastructure bypass,
                                            RunD2ServiceAsync startup wrapper
      • DcsvIo.D2.I18n                    — SupportedLocales + ITranslator
      • DcsvIo.D2.Handler                 — HandlerContext open-generic registration
      • DcsvIo.D2.Auth                    — JwtValidator, JWKS provider, sessions
      • DcsvIo.D2.Auth.Http               — JwtAuthMiddleware + dual-path IRequestContext
      • DcsvIo.D2.Auth.Grpc               — JwtAuthInterceptor + dual-path IRequestContext
      • DcsvIo.D2.Context.Abstractions    — AddD2SystemWorkPlane (via Auth.Http transitive;
                                            declared-use for System work plane)
      • DcsvIo.D2.Caching.Local.Default   — In-process L1 cache (DefaultLocalCache)
      • DcsvIo.D2.Utilities               — D2Env.Load() + Falsey()/Truthy() extensions

    Does NOT own (per the locked design):
      • Encryption                        — DcsvIo.D2.Encryption (per-domain opt-in)
      • Distributed cache                 — DcsvIo.D2.Caching.Distributed.Redis (opt-in)
      • Tiered cache                      — DcsvIo.D2.Caching.Tiered (opt-in)
      • PostgreSQL                        — DcsvIo.D2.Handler.Repo.Postgres (opt-in)
      • RabbitMQ                          — DcsvIo.D2.Messaging.RabbitMq (opt-in)
      • Outbound auth                     — DcsvIo.D2.Auth.Outbound (opt-in)
  -->

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\aspnetcore\DcsvIo.D2.AspNetCore.csproj" />
    <ProjectReference Include="..\auth\core\DcsvIo.D2.Auth.csproj" />
    <ProjectReference Include="..\auth\grpc\DcsvIo.D2.Auth.Grpc.csproj" />
    <ProjectReference Include="..\auth\http\DcsvIo.D2.Auth.Http.csproj" />
    <!--
      context/abstractions — AddD2SystemWorkPlane (platform System work entry +
      default scoped IRequestContext). Declared-use: the aggregator calls it
      directly (not only transitively via Auth.Http).
    -->
    <ProjectReference Include="..\context\abstractions\DcsvIo.D2.Context.Abstractions.csproj" />
    <!--
      auth/startup — deny-by-default boot guard (AuthEndpointGuardStartupCheck +
      AddD2AuthEndpointGuard). Wired via AddD2AuthEndpointGuard() in the
      SkipAuthAutoWiring=false path when SkipAuthEndpointGuard=false (the default).
      Not included in the original 10-lib aggregator list — added as the 11th ref
      for the guard; all behavior still lives in auth/startup, not here.
    -->
    <ProjectReference Include="..\auth\startup\DcsvIo.D2.Auth.Startup.csproj" />
    <ProjectReference Include="..\caching\local-default\DcsvIo.D2.Caching.Local.Default.csproj" />
    <ProjectReference Include="..\handler\core\DcsvIo.D2.Handler.csproj" />
    <ProjectReference Include="..\i18n\core\DcsvIo.D2.I18n.csproj" />
    <ProjectReference Include="..\logging\DcsvIo.D2.Logging.csproj" />
    <ProjectReference Include="..\telemetry\core\DcsvIo.D2.Telemetry.csproj" />
    <ProjectReference Include="..\utilities\DcsvIo.D2.Utilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DcsvIo.D2.Tests" />
  </ItemGroup>

  <!-- Publish metadata (per-package semver + NuGet identity). -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <PackageId>DcsvIo.D2.ServiceDefaults</PackageId>
    <Description>Composition-root aggregator for D2-WORX — wires every shared library into AddD2ServiceDefaults / UseD2DefaultPipeline / MapD2DefaultEndpoints / RunD2ServiceAsync.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
