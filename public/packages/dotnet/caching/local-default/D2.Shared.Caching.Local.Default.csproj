    <Version>0.1.0</Version>
    <PackageId>D2.Shared.Caching.Local.Default</PackageId>
    <Description>Default per-process ILocalCache implementation for D2-WORX, wrapping Microsoft.Extensions.Caching.Memory with in-process lock state.</Description>
