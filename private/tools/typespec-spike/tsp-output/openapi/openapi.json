{
  "openapi": "3.0.0",
  "info": {
    "title": "(title)",
    "version": "0.0.0"
  },
  "tags": [],
  "paths": {
    "/": {
      "post": {
        "operationId": "pushNotificationCreated_submitOrder",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/PushAck"
                    },
                    {
                      "$ref": "#/components/schemas/SubmitOrderOutput"
                    }
                  ]
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "notification": {
                        "$ref": "#/components/schemas/NotificationCreated"
                      }
                    },
                    "required": [
                      "notification"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "input": {
                        "$ref": "#/components/schemas/SubmitOrderInput"
                      }
                    },
                    "required": [
                      "input"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NotificationCreated": {
        "type": "object",
        "required": [
          "id",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Opaque notification id (ULID/GUID string on the wire)."
          },
          "message": {
            "type": "string",
            "description": "Human-readable notification body."
          }
        }
      },
      "PushAck": {
        "type": "object",
        "required": [
          "accepted"
        ],
        "properties": {
          "accepted": {
            "type": "boolean",
            "description": "True once the payload was forwarded to the SSE emit binding."
          }
        }
      },
      "SubmitOrderInput": {
        "type": "object",
        "required": [
          "idempotencyKey",
          "customerId",
          "amountCents"
        ],
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "description": "Header-sourced idempotency key (the `Idempotency-Key` request header)."
          },
          "customerId": {
            "type": "string",
            "description": "Opaque customer id placing the order."
          },
          "amountCents": {
            "type": "integer",
            "format": "int32",
            "description": "Order total in minor units (cents). The thing we must not double-charge."
          }
        }
      },
      "SubmitOrderOutput": {
        "type": "object",
        "required": [
          "orderId",
          "amountCents"
        ],
        "properties": {
          "orderId": {
            "type": "string",
            "description": "Server-assigned order id (proves the handler ran exactly once per key)."
          },
          "amountCents": {
            "type": "integer",
            "format": "int32",
            "description": "Echoed total, for the test to assert the replayed result is identical."
          }
        }
      }
    }
  }
}
