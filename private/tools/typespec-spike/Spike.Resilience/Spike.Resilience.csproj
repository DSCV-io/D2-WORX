<Project Sdk="Microsoft.NET.Sdk">

  <!-- Spike B — resilience pipeline. Contains ONLY the GENERATED files (Outcome
       + the resilience abstraction + the resolved-registry constants + the
       input/output DTOs + the outbound seam + the composed pipeline + the
       open-circuit signal + wiring). It compiles standalone with ZERO
       hand-written code, proving the pipeline is fully generated from one
       @d2Resilience decorator. Isolated under tools/ — does NOT inherit
       Directory.Build.props (no StyleCop / doc-gen / TreatWarningsAsErrors).
       The generated wiring uses Microsoft.Extensions.DependencyInjection.Abstractions. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
  </ItemGroup>

</Project>
