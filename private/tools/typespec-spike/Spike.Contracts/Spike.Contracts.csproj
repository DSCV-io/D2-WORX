<Project Sdk="Microsoft.NET.Sdk">

  <!-- Spike A contracts: compiles the GENERATED notifications.proto via
       Grpc.Tools into the message DTOs + the gRPC service base AND client.
       Isolated under tools/ — does NOT inherit Directory.Build.props,
       so no StyleCop / doc-gen / TreatWarningsAsErrors. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- The proto is emitted by the TypeSpec spike emitter; treat it as input. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.30.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
    <PackageReference Include="Grpc.AspNetCore.Server" Version="2.71.0" />
    <PackageReference Include="Grpc.Tools" Version="2.71.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- GrpcServices="Both" -> generate BOTH PushBase (server, for the Edge
         receiver) and PushClient (client, for service-A in the test). -->
    <Protobuf Include="Protos/notifications.proto" GrpcServices="Both" />
  </ItemGroup>

</Project>
