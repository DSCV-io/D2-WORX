<Project Sdk="Microsoft.NET.Sdk">

  <!-- Spike C — idempotency gate. Contains ONLY the GENERATED files (Outcome +
       store seam + input/output DTOs + handler contract + the gate + wiring).
       It compiles standalone with ZERO hand-written code, proving the gate is
       fully generated from one @d2Idempotent decorator. Isolated under tools/ —
       does NOT inherit Directory.Build.props (no StyleCop / doc-gen /
       TreatWarningsAsErrors). The generated wiring uses
       Microsoft.Extensions.DependencyInjection.Abstractions. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
  </ItemGroup>

</Project>
