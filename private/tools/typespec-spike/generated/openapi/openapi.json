  "components": {
    "schemas": {
      "D2ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "category",
          "userMessageKey"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "userMessageKey": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          }
        }
      },
      "SignInput": {
        "type": "object",
        "required": [
          "keyDomain",
          "payload"
        ],
        "properties": {
          "keyDomain": {
            "type": "string",
            "description": "Logical key domain whose active RSA signing key to use."
          },
          "payload": {
            "type": "string",
            "format": "byte",
            "description": "Raw octets to sign (base64url-encoded in JSON wire; bytes in proto)."
          }
        }
      },
      "SignOutput": {
        "type": "object",
        "required": [
          "signature",
          "kid"
        ],
        "properties": {
          "signature": {
            "type": "string",
            "description": "RS256 signature over the payload, base64url-encoded."
          },
          "kid": {
            "type": "string",
            "description": "kid of the active key that produced this signature."
          }
        }
      }
    }
