<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>D2.Private.Auth</RootNamespace>
    <AssemblyName>D2.Shared.Auth.Abstractions.Extensions</AssemblyName>
    <PackageId>D2.Shared.Auth.Abstractions.Extensions</PackageId>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="$(CompilerGeneratedFilesOutputPath)\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Public twin (OrgType / Role for scopes grantedTo expansion + 1:1 law). -->
    <ProjectReference Include="$(D2PublicPackagesDotnetRoot)auth\abstractions\D2.Shared.Auth.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dual-target generators (scopes + audiences co-home, matching public twin). -->
    <ProjectReference Include="$(D2PublicPackagesDotnetRoot)auth\scopes-source-gen\D2.Shared.Auth.Scopes.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(D2PublicPackagesDotnetRoot)auth\audiences-source-gen\D2.Shared.Auth.Audiences.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Public∪private values for ProductScopes / ProductAudiences union. -->
    <AdditionalFiles Include="$(D2PublicContractsRoot)auth-scopes\scopes.spec.json" />
    <AdditionalFiles Include="$(D2PrivateContractsRoot)auth-scopes\scopes.spec.json" />
    <AdditionalFiles Include="$(D2PublicContractsRoot)auth-audiences\audiences.spec.json" />
    <AdditionalFiles Include="$(D2PrivateContractsRoot)auth-audiences\audiences.spec.json" />
  </ItemGroup>
</Project>
