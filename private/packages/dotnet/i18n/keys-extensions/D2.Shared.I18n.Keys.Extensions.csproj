<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>D2.Private.I18n</RootNamespace>
    <AssemblyName>D2.Shared.I18n.Keys.Extensions</AssemblyName>
    <PackageId>D2.Shared.I18n.Keys.Extensions</PackageId>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="$(CompilerGeneratedFilesOutputPath)\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Public twin (1:1 law); TKMessage flows transitively from Abstractions + IVT. -->
    <ProjectReference Include="$(D2PublicPackagesDotnetRoot)i18n\keys\D2.Shared.I18n.Keys.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(D2PublicPackagesDotnetRoot)i18n\source-gen\D2.Shared.I18n.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Public∪private messages for ProductTK full union. -->
    <AdditionalFiles Include="$(D2PublicContractsRoot)messages\*.json" />
    <AdditionalFiles Include="$(D2PrivateContractsRoot)messages\*.json" />
  </ItemGroup>
</Project>
