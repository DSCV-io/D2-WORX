<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>D2.Private.Encryption</RootNamespace>
    <AssemblyName>D2.Shared.Encryption.Extensions</AssemblyName>
    <PackageId>D2.Shared.Encryption.Extensions</PackageId>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="$(CompilerGeneratedFilesOutputPath)\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Public twin (1:1 law). -->
    <ProjectReference Include="$(D2PublicPackagesDotnetRoot)encryption\core\D2.Shared.Encryption.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(D2PublicPackagesDotnetRoot)encryption\domains-source-gen\D2.Shared.EncryptionDomains.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Public∪private values for ProductEncryptionDomains union. -->
    <AdditionalFiles Include="$(D2PublicContractsRoot)encryption-domains\encryption-domains.spec.json" />
    <AdditionalFiles Include="$(D2PrivateContractsRoot)encryption-domains\encryption-domains.spec.json" />
  </ItemGroup>
</Project>
