<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>D2.Edge.KeyCustodian.Infra</RootNamespace>

    <!--
      Emit the locks-source-gen AdvisoryLocks.g.cs (domain lock-key catalog) to
      <project-dir>/Generated/. Tracked in git so PR reviewers see codegen diffs
      without a local build. LoggerMessage.g.cs under the same tree is gitignored.
    -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The SourceGen pipeline feeds the in-memory compiler with the same content
      that lands on disk under Generated/. Without this Remove, the SDK-default
      <Compile Include="**/*.cs" /> glob picks up the on-disk copy and the build
      fails with duplicate-definition errors (CS0101 / CS0111).
    -->
    <Compile Remove="$(CompilerGeneratedFilesOutputPath)\**\*.cs" />
  </ItemGroup>

  <!--
    Infrastructure — the concrete adapters for the App-owned ports.
    Persistence/Postgres: KeyCustodianDbContext : IKeyCustodianDbContext + the two
    flat IEntityTypeConfiguration<>s (settable Status value column, nullable
    per-state columns, the xmin optimistic-concurrency token, append-only audit FK)
    + the design-time factory + the generated Initial migration. Vault/File:
    FileRootKeyProvider (multi-key root directory — root.key + optional
    root-next.key). Messaging/RabbitMq: the rotation-event announcer + the
    KeyRotatedEvent wire mapper. Scheduling/Hosted: KeyRotationService.
    Observability: KeyCustodianInfraLog + KeyCustodianHealthCheck. Configuration:
    KeyCustodianInfraOptions + the AddD2KeyCustodian(...) composition seam. The
    shared startup migrator + advisory lock mechanism come from
    D2.Shared.EntityFrameworkCore.Postgres; this assembly owns the generated
    AdvisoryLocks.D2Keycustodian.* domain lock-key catalog (central fleet catalog
    SoT: contracts/advisory-locks/).
  -->

  <ItemGroup>
    <!--
      Domain advisory-lock key catalog — spec-driven source-gen. Emits
      AdvisoryLocks.g.cs into THIS assembly only (single-target dispatch on
      assembly name). Shared Postgres owns mechanism only.
    -->
    <ProjectReference
      Include="$(D2PublicPackagesDotnetRoot)entity-framework-core\locks-source-gen\D2.Shared.AdvisoryLocks.SourceGen.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false" />
    <!-- AdditionalFiles wiring: the central fleet catalog is loaded by the
         generator. $(D2PublicContractsRoot) is set in Directory.Build.props. -->
    <AdditionalFiles
      Include="$(D2PrivateContractsRoot)advisory-locks\advisory-locks.spec.json" />
  </ItemGroup>

  <ItemGroup>
    <!--
      D2.Edge.KeyCustodian.App — the DbContext interface + handlers + planners
      that Infra implements and wires.
    -->
    <ProjectReference Include="..\app\D2.Edge.KeyCustodian.App.csproj" />
    <!--
      D2.Edge.KeyCustodian.Domain — the entity types the EF config maps. Listed
      explicitly even though App carries it transitively; the EF
      IEntityTypeConfiguration + migration reference Domain types directly.
    -->
    <ProjectReference Include="..\domain\D2.Edge.KeyCustodian.Domain.csproj" />
    <!--
      D2.Shared.Handler.Repo — BaseRepoHandler plumbing referenced by the DI
      wiring extension. Listed explicitly; carried transitively via App but the
      DI extension touches it directly.
    -->
    <ProjectReference Include="$(D2PublicPackagesDotnetRoot)handler\repo\D2.Shared.Handler.Repo.csproj" />
    <!--
      D2.Shared.Handler.Repo.Postgres — AddD2Postgres() (the IDbExceptionClassifier
      PG implementation that BaseRepoHandler needs) + Npgsql connection management.
    -->
    <ProjectReference Include="$(D2PublicPackagesDotnetRoot)handler\repo-postgres\D2.Shared.Handler.Repo.Postgres.csproj" />
    <!--
      D2.Shared.Encryption — PayloadCryptoKeyring / PayloadCrypto /
      AddD2EncryptionFor / AddD2EncryptionStartupCheck for FileRootKeyProvider +
      the DI extension wiring.
    -->
    <ProjectReference Include="$(D2PublicPackagesDotnetRoot)encryption\core\D2.Shared.Encryption.csproj" />
    <!--
      D2.Shared.Time — SystemClock bind in DI + AddD2NodaTime() EF wiring
      (UseNodaTime on the DbContext options) + the IClock the System-worker
      bootstrap (KeyRotationService/CaSeedingService) timestamps the call-path
      entry with.
    -->
    <ProjectReference Include="$(D2PublicPackagesDotnetRoot)time\D2.Shared.Time.csproj" />
    <!--
      D2.Shared.Auth.Abstractions — D2WorkloadIdentityOptions: the host's own
      workload service id the System-worker bootstrap stamps onto its
      established request context.
    -->
    <ProjectReference Include="$(D2PublicPackagesDotnetRoot)auth\abstractions\D2.Shared.Auth.Abstractions.csproj" />
    <!--
      D2.Shared.Context.Abstractions — ISystemWorkScopeFactory that
      KeyRotationService/CaSeedingService use to open System-plane work scopes
      (platform-owned; modules never re-register IRequestContext).
    -->
    <ProjectReference Include="$(D2PublicPackagesDotnetRoot)context\abstractions\D2.Shared.Context.Abstractions.csproj" />
    <!--
      D2.Shared.Messaging.RabbitMq — the concrete publisher for the
      d2.security.key-rotated rotation event. Infra is the composition/DI
      layer and is allowed to reference the concrete transport lib.
    -->
    <ProjectReference Include="$(D2PublicPackagesDotnetRoot)messaging\rabbitmq\D2.Shared.Messaging.RabbitMq.csproj" />
    <!--
      D2.Shared.Messaging.Abstractions — IMessageBus (the publish port the
      announcer calls) + PublisherOptions. Brought transitively via the RabbitMq
      lib but listed explicitly ("declare what you use").
    -->
    <ProjectReference Include="$(D2PublicPackagesDotnetRoot)messaging\abstractions\D2.Shared.Messaging.Abstractions.csproj" />
    <!--
      D2.Shared.Auth.Events — the KeyRotatedEvent wire DTO (carries
      [MqPub(MqMessages.AuthKeyRotated)]) the KeyRotatedEventMapper builds.
      Deliberately excluded from the App csproj — App is event-blind; the mapper
      that needs the DTO is an infra file.
    -->
    <ProjectReference Include="$(D2PublicPackagesDotnetRoot)auth\events\D2.Shared.Auth.Events.csproj" />
    <!--
      D2.Shared.EntityFrameworkCore.Postgres — the shared PG/EF startup machinery:
      PgAdvisoryLock + AdvisoryLockMigrator<TContext> + DesignTimeDbContextFactoryBase
      + the NpgsqlContextDefaults applier. Mechanism only — domain lock keys are
      emitted into THIS assembly by locks-source-gen (see Analyzer ref above).
    -->
    <ProjectReference Include="$(D2PublicPackagesDotnetRoot)entity-framework-core\postgres\D2.Shared.EntityFrameworkCore.Postgres.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.EntityFrameworkCore.Design — design-time services for
      `dotnet ef migrations add` (the first KeyCustodian migration). PrivateAssets="all" so the design-time assets never flow
      to runtime consumers. CPM-pinned in Directory.Packages.props at 10.0.7
      (same release train as the EF Core base + Relational pins).
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!--
      Npgsql.EntityFrameworkCore.PostgreSQL — the PG provider (UseNpgsql /
      UseNodaTime) for KeyCustodianDbContext. Brings base
      Microsoft.EntityFrameworkCore transitively; no bare EF base ref added
      here to avoid NU1510 (follows the DataGovernance.EFC + Contacts.EFC
      precedent).
    -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!--
      Health-check stack for the KeyCustodian readiness probes. The
      module-within-host infra is a plain Sdk lib (NOT Sdk.Web), so the
      health-check assemblies are explicit package refs rather than coming from a
      framework reference. .HealthChecks ships AddHealthChecks/AddCheck;
      .Abstractions ships IHealthCheck (KeyCustodianHealthCheck implements it);
      .EntityFrameworkCore ships AddDbContextCheck<TContext>.
    -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <!--
      Options + Configuration binding for the AddD2KeyCustodian seam.
      Microsoft.Extensions.Options — AddOptions<T> + IOptions<T>.
      Microsoft.Extensions.Options.ConfigurationExtensions — OptionsBuilder<T>.Bind(section).
      Microsoft.Extensions.Options.DataAnnotations — OptionsBuilder<T>.ValidateDataAnnotations().
      Microsoft.Extensions.Configuration.Abstractions — IConfiguration on the seam signature.
    -->
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="D2.Edge.Tests" />
  </ItemGroup>


</Project>