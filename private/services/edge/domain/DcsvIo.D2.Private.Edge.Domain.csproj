<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DcsvIo.D2.Private.Edge.Domain</RootNamespace>
  </PropertyGroup>

  <!--
    Thin host Domain shell for Edge host-level domain types (not KeyCustodian).
    Future host modules place pure domain logic here. No EF / Options / DI / vendor SDK.
    ProjectReferences satisfy services/Directory.Build.targets Tier-1 global usings
    (Result / Utilities / I18n) so the empty shell still compiles.
  -->

  <ItemGroup>
    <ProjectReference Include="$(D2PublicPackagesDotnetRoot)result\core\DcsvIo.D2.Result.csproj" />
    <ProjectReference Include="$(D2PublicPackagesDotnetRoot)utilities\DcsvIo.D2.Utilities.csproj" />
    <ProjectReference Include="$(D2PublicPackagesDotnetRoot)i18n\core\DcsvIo.D2.I18n.csproj" />
  </ItemGroup>


</Project>