<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>DcsvIo.D2.Private.Edge.Api</RootNamespace>
    <!--
      Runnable Edge composition root (Exe). Owns AddD2EdgeHost / UseD2EdgePipeline /
      MapD2EdgeEndpoints / Program, three-bind Kestrel roles, well-known Map*, and
      co-host KeyCustodian wiring. Assembly name DcsvIo.D2.Private.Edge.Api (not DcsvIo.D2.Private.Edge.API).
    -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Host thin shells (ADR-0020 dependency law). -->
    <ProjectReference Include="..\infra\DcsvIo.D2.Private.Edge.Infra.csproj" />
    <!-- KeyCustodian module-within-host composition. -->
    <ProjectReference Include="..\key-custodian\infra\DcsvIo.D2.Private.Edge.KeyCustodian.Infra.csproj" />
    <ProjectReference Include="..\key-custodian\client\DcsvIo.D2.Private.Edge.KeyCustodian.Client.csproj" />
    <!-- Audit bridge client surface (DTOs + IAuditGrpcClient) — never Audit.Api. -->
    <ProjectReference Include="..\..\audit\clients\dotnet\DcsvIo.D2.Private.Audit.Client.csproj" />
    <!-- Service-defaults aggregator (Auth / MutualTls / health / logging / telemetry). -->

    <ProjectReference Include="$(D2PublicPackagesDotnetRoot)service-defaults\DcsvIo.D2.ServiceDefaults.csproj" />
    <!-- Outbound dual-factor stack (workload leaf + forwarded JWT). -->
    <ProjectReference Include="$(D2PublicPackagesDotnetRoot)auth\outbound\DcsvIo.D2.Auth.Outbound.csproj" />
    <!-- Redis distributed cache + invalidation backplane. -->
    <ProjectReference Include="$(D2PublicPackagesDotnetRoot)caching\distributed-redis\DcsvIo.D2.Caching.Distributed.Redis.csproj" />
    <!-- Tiered cache (L1 local + L2 Redis). -->
    <ProjectReference Include="$(D2PublicPackagesDotnetRoot)caching\tiered\DcsvIo.D2.Caching.Tiered.csproj" />
    <!-- Real RabbitMQ messaging. -->
    <ProjectReference Include="$(D2PublicPackagesDotnetRoot)messaging\rabbitmq\DcsvIo.D2.Messaging.RabbitMq.csproj" />
    <!-- ConnectionStringHelper.ParseRedisUri / ParsePostgresUri. -->
    <ProjectReference Include="$(D2PublicPackagesDotnetRoot)utilities\DcsvIo.D2.Utilities.csproj" />
    <!--
      DcsvIo.D2.Result.Grpc — sole source of D2ResultProto for Edge.Api-owned
      KC protos (sign/issue/cacert). Import "common/v1/d2_result.proto" resolves
      via AdditionalImportDirs; never a second Protobuf include of d2_result
      (CS0433). Also feeds transport-mapper envelope extensions.
    -->
    <ProjectReference Include="$(D2PublicPackagesDotnetRoot)result\grpc\DcsvIo.D2.Result.Grpc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="Grpc.AspNetCore.Server" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Production KeyCustodian protos owned by Edge.Api (compile-once Both):
    sign / issueLeaf / getCaCertificate. Keyring + seal protos compile once in
    DcsvIo.D2.Private.Edge.KeyCustodian.Client (product client stubs); thin services here extend
    Client-generated bases via ProjectReference — never dual Protobuf.
  -->
  <ItemGroup>
    <Protobuf Include="$(MSBuildThisFileDirectory)Protos\KeyCustodian\key_custodian_signer_sign.g.proto"
              GrpcServices="Both"
              ProtoRoot="$(MSBuildThisFileDirectory)"
              AdditionalImportDirs="$(D2PublicContractsRoot)protos" />
    <Protobuf Include="$(MSBuildThisFileDirectory)Protos\KeyCustodian\key_custodian_certificate_authority_issue_workload_certificate.g.proto"
              GrpcServices="Both"
              ProtoRoot="$(MSBuildThisFileDirectory)"
              AdditionalImportDirs="$(D2PublicContractsRoot)protos" />
    <Protobuf Include="$(MSBuildThisFileDirectory)Protos\KeyCustodian\key_custodian_ca_certificate_get_ca_certificate.g.proto"
              GrpcServices="Both"
              ProtoRoot="$(MSBuildThisFileDirectory)"
              AdditionalImportDirs="$(D2PublicContractsRoot)protos" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DcsvIo.D2.Private.Edge.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(D2PrivatePackagesDotnetRoot)auth\abstractions-extensions\DcsvIo.D2.Private.Auth.Abstractions.Extensions.csproj" />
  </ItemGroup>
</Project>