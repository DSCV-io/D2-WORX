<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>DcsvIo.D2.Private.Audit.Api</RootNamespace>
    <!--
      Runnable Audit composition root (Exe). Owns AddD2AuditHost /
      MapD2AuditEndpoints / Program, dual-bind Kestrel (HTTP + mTLS HTTPS),
      and thin gRPC services. gRPC-only public surface — no public REST product.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\infra\DcsvIo.D2.Private.Audit.Infra.csproj" />
    <ProjectReference Include="..\clients\dotnet\DcsvIo.D2.Private.Audit.Client.csproj" />
    <ProjectReference Include="$(D2PublicPackagesDotnetRoot)service-defaults\DcsvIo.D2.ServiceDefaults.csproj" />
    <ProjectReference Include="$(D2PublicPackagesDotnetRoot)auth\grpc\DcsvIo.D2.Auth.Grpc.csproj" />
    <ProjectReference Include="$(D2PublicPackagesDotnetRoot)caching\distributed-redis\DcsvIo.D2.Caching.Distributed.Redis.csproj" />
    <ProjectReference Include="$(D2PublicPackagesDotnetRoot)caching\tiered\DcsvIo.D2.Caching.Tiered.csproj" />
    <ProjectReference Include="$(D2PublicPackagesDotnetRoot)utilities\DcsvIo.D2.Utilities.csproj" />
    <ProjectReference Include="$(D2PublicPackagesDotnetRoot)result\grpc\DcsvIo.D2.Result.Grpc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="Grpc.AspNetCore.Server" />
    <PackageReference Include="Google.Protobuf" />
  </ItemGroup>

  <!--
    Proto ownership: DcsvIo.D2.Private.Audit.Client owns Grpc.Tools Both once. This Api project
    extends the Client-generated server base via ProjectReference — never a
    second Protobuf include (CS0433).
  -->

  <ItemGroup>
    <InternalsVisibleTo Include="DcsvIo.D2.Private.Audit.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(D2PrivatePackagesDotnetRoot)auth\abstractions-extensions\DcsvIo.D2.Private.Auth.Abstractions.Extensions.csproj" />
  </ItemGroup>
</Project>