{
  "skipAutoPermissionPrompt": true,
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Agent",
      "Read(**)",
      "Grep(**)",
      "Glob(**)",
      "Write(docs/wip/daily-reports/*.md)",
      "Bash(git log*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)"
    ],
    "deny": [
      "Read(**/.env.secrets)",
      "Write(**/.env.secrets)",
      "Edit(**/.env.secrets)",
      "Read(**/secrets/**)",
      "Write(**/secrets/**)",
      "Edit(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/.npmrc)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "Bash(cat **/.env.secrets*)",
      "Bash(cat **/secrets/**)",
      "Bash(less **/.env.secrets*)",
      "Bash(head **/.env.secrets*)",
      "Bash(tail **/.env.secrets*)"
    ]
  }
}
