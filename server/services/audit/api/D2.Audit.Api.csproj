<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>D2.Audit.Api</RootNamespace>
    <!--
      Runnable Audit composition root (Exe). Owns AddD2AuditHost /
      MapD2AuditEndpoints / Program, dual-bind Kestrel (HTTP + mTLS HTTPS),
      and thin gRPC services. gRPC-only public surface — no public REST product.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\infra\D2.Audit.Infra.csproj" />
    <ProjectReference Include="..\clients\dotnet\D2.Audit.Client.csproj" />
    <ProjectReference Include="..\..\..\shared\dotnet\service-defaults\D2.Shared.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\..\shared\dotnet\auth\grpc\D2.Shared.Auth.Grpc.csproj" />
    <ProjectReference Include="..\..\..\shared\dotnet\caching\distributed-redis\D2.Shared.Caching.Distributed.Redis.csproj" />
    <ProjectReference Include="..\..\..\shared\dotnet\caching\tiered\D2.Shared.Caching.Tiered.csproj" />
    <ProjectReference Include="..\..\..\shared\dotnet\utilities\D2.Shared.Utilities.csproj" />
    <ProjectReference Include="..\..\..\shared\dotnet\result\grpc\D2.Shared.Result.Grpc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="Grpc.AspNetCore.Server" />
    <PackageReference Include="Google.Protobuf" />
  </ItemGroup>

  <!--
    Proto ownership: D2.Audit.Client owns Grpc.Tools Both once. This Api project
    extends the Client-generated server base via ProjectReference — never a
    second Protobuf include (CS0433).
  -->

  <ItemGroup>
    <InternalsVisibleTo Include="D2.Audit.Tests" />
  </ItemGroup>
</Project>
