<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>D2.Edge.KeyCustodian.Domain</RootNamespace>
    <!--
      Emit the SrcGen-emitted KeyCustodianErrorCodes.g.cs + KeyCustodianFailures.g.cs
      + KeyCustodianFailures.Generic.g.cs (driven by the keycustodian-error-codes
      analyzer wired below) to <project-dir>/Generated/. The directory is tracked
      in git so PR reviewers see codegen diffs without a local build.
    -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The SourceGen pipeline feeds the in-memory compiler with the same content
      that lands on disk under Generated/. Without this Remove, the SDK-default
      <Compile Include="**/*.cs" /> glob picks up the on-disk copy and the build
      fails with duplicate-definition errors (CS0101 / CS0111).
    -->
    <Compile Remove="$(CompilerGeneratedFilesOutputPath)\**\*.cs" />
  </ItemGroup>

  <!--
    Pure domain — the sum-type EncryptionKey state machine (abstract base + sealed
    per-state types), Kid strong-typed id, KeyStatus / KeyType enums, KeyDomain
    catalog, EncryptionKeyAudit, RotationPolicy VOs. EF-free by design — zero
    Microsoft.EntityFrameworkCore reference.

    net10.0 / CPM / Nullable / ImplicitUsings / StyleCop / TreatWarningsAsErrors /
    GenerateDocumentationFile inherited from server/Directory.Build.props.
  -->

  <ItemGroup>
    <!--
      D2.Shared.Result — D2Result<T> semantic factories (Ok, ValidationFailed,
      BubbleFail) returned by VO smart constructors and state-machine transition
      methods.
    -->
    <ProjectReference Include="..\..\..\..\shared\dotnet\result\core\D2.Shared.Result.csproj" />
    <!--
      D2.Shared.Utilities — Falsey()/Truthy()/ThrowIfFalsey()/TryParseTruthyNull
      guards, [RedactData] attribute + RedactReason enum for PII-safe logging of
      key identifiers.
    -->
    <ProjectReference Include="..\..\..\..\shared\dotnet\utilities\D2.Shared.Utilities.csproj" />
    <!--
      D2.Shared.Time — NodaTime Instant/Duration + IClock seam for CreatedAt /
      transition timestamps / RotationPolicy durations. EF-free — only the
      domain types and clock abstraction.
    -->
    <ProjectReference Include="..\..\..\..\shared\dotnet\time\D2.Shared.Time.csproj" />
    <!--
      D2.Shared.Encryption — EncryptionDomains catalog; the KeyDomain catalog
      unions EncryptionDomains.AllDomains. Pulls D2.Shared.Utilities transitively
      but listed explicitly because Domain uses Utilities guards directly.
    -->
    <ProjectReference Include="..\..\..\..\shared\dotnet\encryption\core\D2.Shared.Encryption.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Source generator driving the codegen-emitted KeyCustodianErrorCodes /
      KeyCustodianFailures classes. The spec file is surfaced via AdditionalFiles
      so the SrcGen can read it at codegen time; the analyzer single-targets on
      D2.Edge.KeyCustodian.Domain.
    -->
    <ProjectReference Include="..\error-codes-source-gen\D2.Edge.KeyCustodian.ErrorCodes.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="$(D2ContractsRoot)keycustodian-error-codes\keycustodian-error-codes.spec.json" />
    <!--
      en-US.json (the translation-key source of truth) surfaced so the
      error-codes SrcGen can cross-check every userMessageKey resolves to a
      real key (D2ERC002). The generator reduces it to just its key SET at
      the pipeline boundary so a translation-VALUE edit does not re-run codegen.
    -->
    <AdditionalFiles Include="$(D2ContractsRoot)messages\en-US.json" />
    <!--
      error-category.spec.json — the closed ErrorCategory wire set surfaced so the
      error-codes SrcGen's category-membership check (D2KEC002) validates against
      the spec-derived set rather than a hand-maintained subset. Absent / malformed
      degrades the check to a no-op (no false positives).
    -->
    <AdditionalFiles Include="$(D2ContractsRoot)error-category\error-category.spec.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="D2.Edge.Tests" />
  </ItemGroup>
</Project>
