<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>D2.Edge.KeyCustodian.Infra</RootNamespace>
  </PropertyGroup>

  <!--
    Infrastructure — KeyCustodianDbContext : IKeyCustodianDbContext + the
    first-in-codebase EF Core TPH IEntityTypeConfiguration (strong-typed Kid
    converter, HasDiscriminator(e => e.Status)…IsComplete(false), audit config) +
    the first migration; FileRootKeyProvider (reads secrets/keycustodian/root.key);
    the rotation-event publisher; AdvisoryLockMigrator + KeyRotationService
    (IHostedService); KeyCustodianLog; AddD2KeyCustodian(...) DI (+
    EF Core OTel instrumentation).
  -->

  <ItemGroup>
    <!--
      D2.Edge.KeyCustodian.App — the DbContext interface + handlers + planners
      that Infra implements and wires.
    -->
    <ProjectReference Include="..\app\D2.Edge.KeyCustodian.App.csproj" />
    <!--
      D2.Edge.KeyCustodian.Domain — the entity types the EF config maps. Listed
      explicitly even though App carries it transitively; the EF
      IEntityTypeConfiguration + migration reference Domain types directly.
    -->
    <ProjectReference Include="..\domain\D2.Edge.KeyCustodian.Domain.csproj" />
    <!--
      D2.Shared.Handler.Repo — BaseRepoHandler plumbing referenced by the DI
      wiring extension. Listed explicitly; carried transitively via App but the
      DI extension touches it directly.
    -->
    <ProjectReference Include="..\..\..\..\shared\dotnet\handler\repo\D2.Shared.Handler.Repo.csproj" />
    <!--
      D2.Shared.Handler.Repo.Postgres — AddD2Postgres() (the IDbExceptionClassifier
      PG implementation that BaseRepoHandler needs) + Npgsql connection management.
    -->
    <ProjectReference Include="..\..\..\..\shared\dotnet\handler\repo-postgres\D2.Shared.Handler.Repo.Postgres.csproj" />
    <!--
      D2.Shared.Encryption — PayloadCryptoKeyring / PayloadCrypto /
      AddD2EncryptionFor / AddD2EncryptionStartupCheck for FileRootKeyProvider +
      the DI extension wiring.
    -->
    <ProjectReference Include="..\..\..\..\shared\dotnet\encryption\core\D2.Shared.Encryption.csproj" />
    <!--
      D2.Shared.Time — SystemClock bind in DI + AddD2NodaTime() EF wiring
      (UseNodaTime on the DbContext options).
    -->
    <ProjectReference Include="..\..\..\..\shared\dotnet\time\D2.Shared.Time.csproj" />
    <!--
      D2.Shared.Messaging.RabbitMq — the concrete publisher for the
      d2.security.key-rotated rotation event. Infra is the composition/DI
      layer and is allowed to reference the concrete transport lib.
    -->
    <ProjectReference Include="..\..\..\..\shared\dotnet\messaging\rabbitmq\D2.Shared.Messaging.RabbitMq.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.EntityFrameworkCore.Design — design-time services for
      `dotnet ef migrations add` (the first KeyCustodian migration, added
      in Step 3). PrivateAssets="all" so the design-time assets never flow
      to runtime consumers. CPM-pinned in Directory.Packages.props at 10.0.7
      (same release train as the EF Core base + Relational pins).
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!--
      Npgsql.EntityFrameworkCore.PostgreSQL — the PG provider (UseNpgsql /
      UseNodaTime) for KeyCustodianDbContext. Brings base
      Microsoft.EntityFrameworkCore transitively; no bare EF base ref added
      here to avoid NU1510 (follows the DataGovernance.EFC + Contacts.EFC
      precedent).
    -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="D2.Edge.Tests" />
  </ItemGroup>
</Project>
