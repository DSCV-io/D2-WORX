<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>D2.Edge.Api</RootNamespace>
    <!--
      Runnable Edge composition root (Exe). Owns AddD2EdgeHost / UseD2EdgePipeline /
      MapD2EdgeEndpoints / Program, three-bind Kestrel roles, well-known Map*, and
      co-host KeyCustodian wiring. Assembly name D2.Edge.Api (not D2.Edge.API).
    -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Host thin shells (ADR-0020 dependency law). -->
    <ProjectReference Include="..\infra\D2.Edge.Infra.csproj" />
    <!-- KeyCustodian module-within-host composition. -->
    <ProjectReference Include="..\key-custodian\infra\D2.Edge.KeyCustodian.Infra.csproj" />
    <ProjectReference Include="..\key-custodian\client\D2.Edge.KeyCustodian.Client.csproj" />
    <!-- Service-defaults aggregator (Auth / MutualTls / health / logging / telemetry). -->
    <ProjectReference Include="..\..\..\shared\dotnet\service-defaults\D2.Shared.ServiceDefaults.csproj" />
    <!-- Outbound dual-factor stack (workload leaf + forwarded JWT). -->
    <ProjectReference Include="..\..\..\shared\dotnet\auth\outbound\D2.Shared.Auth.Outbound.csproj" />
    <!-- Redis distributed cache + invalidation backplane. -->
    <ProjectReference Include="..\..\..\shared\dotnet\caching\distributed-redis\D2.Shared.Caching.Distributed.Redis.csproj" />
    <!-- Tiered cache (L1 local + L2 Redis). -->
    <ProjectReference Include="..\..\..\shared\dotnet\caching\tiered\D2.Shared.Caching.Tiered.csproj" />
    <!-- Real RabbitMQ messaging. -->
    <ProjectReference Include="..\..\..\shared\dotnet\messaging\rabbitmq\D2.Shared.Messaging.RabbitMq.csproj" />
    <!-- ConnectionStringHelper.ParseRedisUri / ParsePostgresUri. -->
    <ProjectReference Include="..\..\..\shared\dotnet\utilities\D2.Shared.Utilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="Grpc.AspNetCore.Server" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="D2.Edge.Tests" />
  </ItemGroup>
</Project>
