<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>D2.Edge.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>

    <!--
      Test-project-only warning suppressions. Public-API XML-doc + comment-style
      enforcement remains active for non-test libraries.

      CS1591 (Roslyn) / SA1600 (StyleCop): missing XML doc on public types/members.
      Test method names follow `Method_Scenario_ExpectedResult` which IS the
      documentation; requiring a `summary` echo on every test adds noise.

      SA1512: single-line `//` comments not followed by blank lines. Section
      dividers inside test classes are clearer with a blank line before the next
      test method; SA1512 disagrees. Tests prioritize scan readability over the rule.
    -->
    <!--
      xUnit1051: "use TestContext.Current.CancellationToken on every awaited
      method that accepts a ct" — well-intentioned but exceptionally noisy in
      unit tests that don't model cancellation; xUnit's own timeout already
      bounds runaway tests. Suppressed for clarity.
    -->
    <NoWarn>$(NoWarn);1591;SA1600;SA1512;xUnit1051</NoWarn>
  </PropertyGroup>

  <!--
    Edge-service test project. The integration-key-rotation Testcontainers gate (own
    PostgresFixture + [Collection("Postgres")]) + temporal/adversarial unit
    tests are housed here. Mirrors D2.Shared.Tests csproj settings (MTP runner, the standard
    test-only NoWarn set).
  -->

  <ItemGroup>
    <!--
      Microsoft.AspNetCore.App framework reference — required so test code can
      construct gRPC service stubs (extend the Grpc.Tools base class) and host
      them via AspNetCore's in-memory TestServer (Microsoft.AspNetCore.TestHost).
      Adding via FrameworkReference follows the AspNetCore conventional opt-in;
      not a PackageReference to avoid NU1510.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="JetBrains.Annotations" />
    <!-- Testcontainers.PostgreSql — for the integration-key-rotation gate (real PG
         container with own PostgresFixture + [Collection("Postgres")]). -->
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!-- Testcontainers.RabbitMq — real broker for the keyring rotation hot-swap
         headline integration test (real RotateKeyHandler → KeyRotatedEvent over the
         broker → consumer-driven wrapper swap). -->
    <PackageReference Include="Testcontainers.RabbitMq" />
    <PackageReference Include="coverlet.msbuild">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!--
      Microsoft.CodeAnalysis.CSharp — needed by the keycustodian-error-codes
      SrcGen integration tests (Unit/KeyCustodian/SourceGen +
      Unit/KeyCustodian/SpecsConsistency) which drive CSharpGeneratorDriver
      against synthetic compilations + byte-compare the committed .g.cs. The
      SrcGen csproj marks this PrivateAssets="all" so it doesn't propagate;
      tests need an explicit reference.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <!--
      Microsoft.EntityFrameworkCore + .InMemory — the App-layer mapper / query-
      extension / handler unit tests drive a test-owned KeyCustodianTestDbContext
      on the provider-free in-memory database. Relational specifics (xmin token,
      Instant value-converters, real SQL translation) are Infra + Testcontainers concerns; the InMemory provider exercises behavior here.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <!--
      Microsoft.Extensions.DependencyInjection / Configuration / Binder /
      EnvironmentVariables — previously listed explicitly; now supplied by the
      FrameworkReference Microsoft.AspNetCore.App added above. Keeping explicit
      PackageReferences triggers NU1510 ("will not be pruned"); removed per the
      same pattern as D2.Shared.Tests which follows the same FrameworkReference
      + no-duplicate discipline.
      Tests that need ServiceCollection / IConfiguration still compile because
      the framework reference ships those packages into the compile/runtime closure.
    -->
    <!-- Microsoft.AspNetCore.TestHost — in-memory web host for the TypeSpec gRPC
         harness tests (GrpcServiceImplTests). Hosts the generated gRPC service
         via MapGrpcService<T>() inside a TestServer and connects via an in-process
         GrpcChannel (no network sockets). -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <!-- Grpc.Tools — drives protoc + the C# plugin for the test-only
         TypeSpecGrpc/Protos/sign_fixture_signer_sign_fixture.g.proto fixture. Build-only;
         PrivateAssets="all" so the targets do not flow to consumers. -->
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Grpc.AspNetCore.Server — server-side gRPC binding; provides AddGrpc() /
         MapGrpcService<T>() used in the TypeSpec gRPC harness host setup. -->
    <PackageReference Include="Grpc.AspNetCore.Server" />
    <!-- Grpc.Net.Client — client-side channel for the in-process gRPC integration
         test (constructs a GrpcChannel atop the TestServer's HttpClient). -->
    <PackageReference Include="Grpc.Net.Client" />
    <!-- Grpc.Net.ClientFactory — AddGrpcClient<TStub>() extension used by the generated
         gRPC client DI fixture (TypeSpecGrpc/Generated/SignFixtureGrpcClientsGenerated.g.cs)
         to register the channel. The fixture validates the emitter's DI-ext output compiles
         + resolves; the production Clients project gains this ref in its own (later) step. -->
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <!-- Google.Protobuf — runtime types (IMessage, ByteString, etc.) consumed by
         the Grpc.Tools-generated code for the proto fixture. -->
    <PackageReference Include="Google.Protobuf" />
  </ItemGroup>

  <ItemGroup>
    <!--
      D2.Shared.Logging — the TypeSpec validation tests drive the generated
      SignInput record through RedactDataDestructuringPolicy (IVT granted in
      D2.Shared.Logging.csproj) to assert that [property: RedactData] on a
      generated positional-record parameter is correctly seen by the policy's
      property-reflecting destructuring path.
    -->
    <ProjectReference Include="..\..\..\shared\dotnet\logging\D2.Shared.Logging.csproj" />
    <!--
      D2.Shared.Result.Grpc — provides:
        1. The C# D2ResultProto type (D2.Services.Protos.Common.V1.D2ResultProto),
           generated from contracts/protos/common/v1/d2_result.proto via Grpc.Tools.
        2. The D2Result.ToProto() and D2ResultProto.ToD2Result<T>() extension methods
           used by the generated SignFixtureTransportMappers.g.cs (ToProtoResponse).
      This is the SOLE source of D2ResultProto in this assembly — no second Protobuf
      include for d2_result.proto is added here (that would double-generate the type
      and cause CS0433). The fixture proto's import "common/v1/d2_result.proto" is
      resolved at protoc time via the ProtoRoot search path on the fixture Protobuf
      item (see ItemGroup below).
    -->
    <ProjectReference Include="..\..\..\shared\dotnet\result\grpc\D2.Shared.Result.Grpc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Serilog — for the TypeSpec validation test that constructs a local
      LoggerConfiguration + InMemorySink to drive the real redaction pipeline.
      Serilog.AspNetCore is a transitive dep of D2.Shared.Logging; we reference
      the core Serilog package explicitly for the test's LoggerConfiguration +
      LogEventLevel usage, and use Serilog.Sinks.Spectre as the in-memory sink
      equivalent via LogEvents capture.
    -->
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\key-custodian\domain\D2.Edge.KeyCustodian.Domain.csproj" />
    <ProjectReference Include="..\key-custodian\app\D2.Edge.KeyCustodian.App.csproj" />
    <ProjectReference Include="..\key-custodian\client\D2.Edge.KeyCustodian.Client.csproj" />
    <ProjectReference Include="..\key-custodian\infra\D2.Edge.KeyCustodian.Infra.csproj" />
    <!--
      D2.Shared.Resilience — ResilientPipeline<TKey,TValue> + AddResilientPipeline +
      ResilientPipeline<…>.PassThrough, consumed by the TypeSpec gRPC client harness
      (GrpcClientTests) which drives the generated SignFixtureGrpcClient fixture through
      the in-memory channel + per-call pipeline overrides. The generated client fixture
      (TypeSpecGrpc/Generated/) compiles inside this test project against the same proto
      compile (GrpcServices="Both"); no production project compiles the fixture proto.
    -->
    <ProjectReference Include="..\..\..\shared\dotnet\resilience\D2.Shared.Resilience.csproj" />
    <!--
      D2.Shared.Auth.Http — route-policy enforcement tests wire JwtAuthMiddleware
      via UseD2Auth() + RequireAnyScope/RequireAllScopes/MarkAsD2HarmlessEndpoint.
      Also provides D2.Shared.Auth (AuthOptions/JwtValidator) and
      D2.Shared.Auth.Abstractions (IJwksProvider/ISessionLivenessTracker) transitively.
    -->
    <ProjectReference Include="..\..\..\shared\dotnet\auth\http\D2.Shared.Auth.Http.csproj" />
    <!--
      D2.Shared.Auth.Grpc — the gRPC-transport overload of the capability-general
      peer-identity accessor (ServerCallContext.GetD2PeerWorkloadIdentity()), which
      the mTLS harness's hosted gRPC service reads to prove the validated peer SAN
      surfaces over a real TLS handshake.
    -->
    <ProjectReference Include="..\..\..\shared\dotnet\auth\grpc\D2.Shared.Auth.Grpc.csproj" />
    <!--
      D2.Shared.Caching.Local.Default — AddD2LocalCache() extension used in the
      route-policy TestServer host setup to satisfy JwtValidator's tiered-cache DI
      dependency. Also provides D2.Shared.Caching.Abstractions transitively.
    -->
    <ProjectReference Include="..\..\..\shared\dotnet\caching\local-default\D2.Shared.Caching.Local.Default.csproj" />
    <!--
      The keycustodian-error-codes SrcGen referenced as a NORMAL library (not an
      Analyzer) so the generator/diagnostic + byte-parity tests can drive
      ErrorCodesGenerator + read ErrorCodesGenerator.Config directly. The Domain
      consumes the SAME project as an Analyzer; here it is a plain reference for
      test-time introspection. The unified engine namespace
      (D2.Shared.ErrorCodes.SourceGen) is unique in this test assembly's closure
      (only the KC shell is referenced) so there is no CS0433 ambiguity.
    -->
    <ProjectReference Include="..\key-custodian\error-codes-source-gen\D2.Edge.KeyCustodian.ErrorCodes.SourceGen.csproj" />
    <!--
      D2.Shared.AspNetCore — the shipped mutual-TLS host wiring (AddD2MutualTls +
      D2MutualTlsOptions). The end-to-end mTLS harness binds a real Kestrel HTTPS
      endpoint configured via AddD2MutualTls and hosts the generated Signer gRPC
      service over it, proving the require-and-validate path gates a real TLS
      handshake. A service test project referencing a shared lib is the correct
      dependency direction.
    -->
    <ProjectReference Include="..\..\..\shared\dotnet\aspnetcore\D2.Shared.AspNetCore.csproj" />
    <!--
      D2.Shared.Auth.Outbound — the shipped client-side workload-leaf presentation
      stack (AddD2WorkloadCertificateOutbound + AddD2WorkloadCertificate +
      IWorkloadCertificateIssuer + IWorkloadLeafSource + WorkloadLeafMaterial). The
      harness's valid-leaf case dials through this client plumbing to prove the
      real present-from-cache path end-to-end. Also pulls D2.Shared.WorkloadIdentity
      transitively (the SPIFFE grammar both the server validator + KeyCustodian's
      issuance path share).
    -->
    <ProjectReference Include="..\..\..\shared\dotnet\auth\outbound\D2.Shared.Auth.Outbound.csproj" />
  </ItemGroup>

  <!--
    Committed proto fixture for the TypeSpec gRPC harness tests.
    Compiled in Both mode (server base class + client stub) so the test can
    host the generated service class via MapGrpcService<T>() AND dial it via
    the generated Grpc.Net.Client stub. NOT a wire contract — strictly a
    validation harness internal to the test project; lives alongside the
    other TypeSpec fixture files.

    ProtoRoot is set to contracts/protos/ (via D2ContractsRoot) so that the
    fixture proto's import "common/v1/d2_result.proto" resolves at protoc
    time via the proto_path search. Grpc.Tools passes ProtoRoot as an
    additional proto_path entry. The D2ResultProto C# type is NOT re-generated
    here; it comes solely from the D2.Shared.Result.Grpc ProjectReference
    above (avoiding CS0433 double-generation). The AdditionalImportDirs attribute
    adds the fixture directory so its relative includes also resolve.
  -->
  <ItemGroup>
    <!--
      ProtoRoot is the test project directory so the proto file (under Unit/)
      resides within it. AdditionalImportDirs adds contracts/protos/ to the
      protoc search path so the fixture's import "common/v1/d2_result.proto"
      resolves. The C# type D2ResultProto is NOT re-generated here (no second
      Protobuf include for d2_result.proto); it comes solely from the
      D2.Shared.Result.Grpc ProjectReference above, avoiding CS0433.
      GrpcServices="Both" generates both the server base class and client stub
      so the test can host via MapGrpcService<T>() and dial via the stub.
    -->
    <Protobuf Include="$(MSBuildThisFileDirectory)Unit/KeyCustodian/TypeSpecGrpc/Protos/sign_fixture_signer_sign_fixture.g.proto"
              GrpcServices="Both"
              ProtoRoot="$(MSBuildThisFileDirectory)"
              AdditionalImportDirs="$(D2ContractsRoot)protos" />
    <!--
      Real KeyCustodian sign proto — the FIRST real (non-fixture) gRPC wire surface
      (key-custodian.tsp sign op; package d2.keycustodian.v2alpha, csharp_namespace
      D2.Services.Protos.KeyCustodian.V2Alpha). Generates the KeyCustodianSigner service
      base + SignRequest/SignResponse/SignOutput messages. The generated
      KeyCustodianSignerService delegates to IKeyCustodianApi.SignAsync; hosted via
      MapGrpcService<T>() + dialed via the generated stub in GrpcSignerServiceTests. The
      live host wiring (the Edge composition root mapping + the cross-process client) is
      deferred until the Edge host exists; the serving plane is TestServer-proven here. Compiled in Both mode; the
      D2ResultProto type still comes solely from the D2.Shared.Result.Grpc ProjectReference
      above (this proto's import "common/v1/d2_result.proto" resolves via the same
      AdditionalImportDirs proto_path; no second d2_result.proto Protobuf include).
    -->
    <Protobuf Include="$(MSBuildThisFileDirectory)Unit/KeyCustodian/TypeSpecGrpc/Protos/key_custodian_signer_sign.g.proto"
              GrpcServices="Both"
              ProtoRoot="$(MSBuildThisFileDirectory)"
              AdditionalImportDirs="$(D2ContractsRoot)protos" />
    <!--
      Real KeyCustodian keyring proto — PROMOTED: its <Protobuf> compilation now
      lives in D2.Edge.KeyCustodian.Client (GrpcServices="Both"), which this test project
      references. The keyring client stub, the wire messages
      (D2.Services.Protos.KeyCustodian.V2Alpha.*), AND the server base its generated
      KeyCustodianKeyringService extends all come from that project — so the messages
      compile EXACTLY ONCE. Re-adding a keyring <Protobuf> item here would double-generate
      the messages (CS0433). The .g.proto file itself still lives under
      Unit/KeyCustodian/TypeSpecGrpc/Protos/ (the emitter's output location) — only the
      compilation moved.
    -->
    <!--
      Real KeyCustodian certificate-authority issuance proto — the workload leaf-issuance
      wire surface (key-custodian.tsp issueLeaf op; wire method IssueWorkloadCertificate;
      package d2.keycustodian.v2alpha, csharp_namespace
      D2.Services.Protos.KeyCustodian.V2Alpha — a DISTINCT service
      KeyCustodianCertificateAuthority). CSR bytes in, leaf + issuing-intermediate DER out —
      all-public material (the leaf private key never crosses the wire). Generates the
      KeyCustodianCertificateAuthority service base + IssueWorkloadCertificateRequest/
      IssueWorkloadCertificateResponse/IssueLeafOutput messages. The generated
      KeyCustodianCertificateAuthorityService delegates to IKeyCustodianApi.IssueLeafAsync;
      hosted via MapGrpcService<T>() + dialed via the generated stub in
      GrpcCertificateAuthorityServiceTests. The live host wiring is deferred until the Edge
      host exists; the serving plane is TestServer-proven here. Compiled in Both mode; the
      D2ResultProto type still comes solely from the D2.Shared.Result.Grpc ProjectReference
      above (same AdditionalImportDirs proto_path resolution; no second d2_result.proto
      Protobuf include).
    -->
    <Protobuf Include="$(MSBuildThisFileDirectory)Unit/KeyCustodian/TypeSpecGrpc/Protos/key_custodian_certificate_authority_issue_workload_certificate.g.proto"
              GrpcServices="Both"
              ProtoRoot="$(MSBuildThisFileDirectory)"
              AdditionalImportDirs="$(D2ContractsRoot)protos" />
    <!--
      Real KeyCustodian CA-certificate proto — the trust-anchor distribution wire surface
      (key-custodian.tsp getCaCertificate op; package d2.keycustodian.v2alpha,
      csharp_namespace D2.Services.Protos.KeyCustodian.V2Alpha — a DISTINCT service
      KeyCustodianCaCertificate; one gRPC service per op so each service carries its own
      transport scope policy). Empty request in, root + issuing-intermediate DER out
      (public trust material). Generates the KeyCustodianCaCertificate service base +
      GetCaCertificateRequest/GetCaCertificateResponse/GetCaCertificateOutput messages.
      The generated KeyCustodianCaCertificateService delegates to
      IKeyCustodianApi.GetCaCertificateAsync; hosted via MapGrpcService<T>() + dialed via
      the generated stub in GrpcCertificateAuthorityServiceTests. The live host wiring is
      deferred until the Edge host exists; the serving plane is TestServer-proven here.
      Compiled in Both mode; the D2ResultProto type still comes solely from the
      D2.Shared.Result.Grpc ProjectReference above (same AdditionalImportDirs proto_path
      resolution; no second d2_result.proto Protobuf include).
    -->
    <Protobuf Include="$(MSBuildThisFileDirectory)Unit/KeyCustodian/TypeSpecGrpc/Protos/key_custodian_ca_certificate_get_ca_certificate.g.proto"
              GrpcServices="Both"
              ProtoRoot="$(MSBuildThisFileDirectory)"
              AdditionalImportDirs="$(D2ContractsRoot)protos" />
    <!--
      Second TypeSpec gRPC fixture proto — the enum-string-field bridge fixture
      (enum-shaped.tsp signWithKindFixture op). An enum DTO field maps to a proto `string`
      field; the generated SignWithKindFixtureTransportMappers.g.cs parses the wire string
      back to the C# enum, failing loud (400 ValidationFailed) on an unknown value.
      Compiled in Both mode so the EnumWireRoundTripTests can host the service via
      MapGrpcService<T>() and dial it via the generated stub. The D2ResultProto type
      still comes solely from the D2.Shared.Result.Grpc ProjectReference above
      (this proto's import "common/v1/d2_result.proto" resolves via the same
      AdditionalImportDirs proto_path; no second d2_result.proto Protobuf include).
    -->
    <Protobuf Include="$(MSBuildThisFileDirectory)Unit/KeyCustodian/TypeSpecGrpcEnum/Protos/enum_fixtures_signer_sign_with_kind_fixture.g.proto"
              GrpcServices="Both"
              ProtoRoot="$(MSBuildThisFileDirectory)"
              AdditionalImportDirs="$(D2ContractsRoot)protos" />
    <!--
      Third TypeSpec gRPC fixture proto — the @d2Resilience retryWhen/failWhen
      custom-predicate fixture (resilience-predicate-shaped.tsp placeOrderFixture op). The
      rich output shape (array-of-model + optional nested model) exercises the
      cross-language predicate emitter + the gRPC client's business-retry sentinel.
      Compiled in Both mode so the PredicateRetryTests can host a fault-injecting
      service via MapGrpcService<T>() and dial it via the generated stub. The
      D2ResultProto type still comes solely from the D2.Shared.Result.Grpc
      ProjectReference above (this proto's import "common/v1/d2_result.proto"
      resolves via the same AdditionalImportDirs proto_path; no second
      d2_result.proto Protobuf include).
    -->
    <Protobuf Include="$(MSBuildThisFileDirectory)Unit/KeyCustodian/TypeSpecGrpcPredicate/Protos/predicate_fixtures_orders_place_order_fixture.g.proto"
              GrpcServices="Both"
              ProtoRoot="$(MSBuildThisFileDirectory)"
              AdditionalImportDirs="$(D2ContractsRoot)protos" />
    <!--
      Fourth + fifth TypeSpec gRPC fixture protos — the NESTED-MODEL / array-of-MODEL
      transport-mapper fixtures. predicate_fixtures_orders_v2_place_order_v2_fixture.g.proto
      carries an optional nested model (PlaceOrderV2FixtureCustomer) + an array-of-model
      (repeated PlaceOrderFixtureLine); predicate_fixtures_gizmos_deep_deep_nest_fixture.g.proto proves
      arbitrary depth (DeepNestFixtureOutput -> DeepFixtureWidget -> repeated DeepFixturePart). Compiled in
      Both mode so PlaceOrderV2RoundTripTests + DeepNestRoundTripTests can host a service
      shim via MapGrpcService<T>() and dial it via the generated stub. Each uses a DISTINCT
      proto package + csharp_namespace + service name so the generated C# types never
      collide with the V1 PredicateFixturesOrders proto. The D2ResultProto type still comes
      solely from the D2.Shared.Result.Grpc ProjectReference above (each proto's import
      "common/v1/d2_result.proto" resolves via the same AdditionalImportDirs proto_path; no
      second d2_result.proto Protobuf include).
    -->
    <Protobuf Include="$(MSBuildThisFileDirectory)Unit/KeyCustodian/TypeSpecGrpcPredicate/Protos/predicate_fixtures_orders_v2_place_order_v2_fixture.g.proto"
              GrpcServices="Both"
              ProtoRoot="$(MSBuildThisFileDirectory)"
              AdditionalImportDirs="$(D2ContractsRoot)protos" />
    <Protobuf Include="$(MSBuildThisFileDirectory)Unit/KeyCustodian/TypeSpecGrpcPredicate/Protos/predicate_fixtures_gizmos_deep_deep_nest_fixture.g.proto"
              GrpcServices="Both"
              ProtoRoot="$(MSBuildThisFileDirectory)"
              AdditionalImportDirs="$(D2ContractsRoot)protos" />
  </ItemGroup>
</Project>
