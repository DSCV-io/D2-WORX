<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>D2.Shared.Messaging</RootNamespace>

    <!-- Emit the Messaging.SourceGen output (MqMessages.g.cs, MqSubscriptions.g.cs)
         to <project-dir>/Generated/. The directory is tracked in git so PR
         reviewers see codegen diffs without a local build. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The SourceGen pipeline feeds the in-memory compiler with the same content
      that lands on disk under Generated/. Without this Remove, the SDK-default
      <Compile Include="**/*.cs" /> glob picks up the on-disk copy and the build
      fails with duplicate-definition errors (CS0101 / CS0111). See:
      https://learn.microsoft.com/dotnet/core/project-sdk/msbuild-props#compilergeneratedfilesoutputpath
    -->
    <Compile Remove="$(CompilerGeneratedFilesOutputPath)\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Zero external runtime deps so domain code can reference [MqPub] /
      [MqSub] and the messaging interfaces without dragging in
      RabbitMQ.Client or any transport. Future Kafka / NATS impls live in
      sibling csprojs with the same surface.
    -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />

    <ProjectReference Include="..\result\D2.Shared.Result.csproj" />
    <ProjectReference Include="..\i18n-abstractions\D2.Shared.I18n.Abstractions.csproj" />
    <ProjectReference Include="..\handler\D2.Shared.Handler.csproj" />
    <ProjectReference Include="..\utilities\D2.Shared.Utilities.csproj" />

    <!--
      Encryption ref needed for D2.Shared.Encryption.EncryptionDomains constants —
      Messaging.SourceGen reads them at codegen time to validate the encryption
      value on each message spec entry (whitelist of registered domains + the
      literal "plaintext").
    -->
    <ProjectReference Include="..\encryption\D2.Shared.Encryption.csproj" />

    <!-- Messaging.SourceGen — emits MqMessages / MqSubscriptions + their registries. -->
    <ProjectReference Include="..\messaging-source-gen\D2.Shared.Messaging.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <!--
      DlqFailureMetadata SourceGen — multi-target. The Fields-half emits into
      this csproj (DlqFailureMetadataFields.g.cs — the JSON property-name
      catalog consumed by [JsonPropertyName] attributes on DlqFailureMetadata).
      The Causes-half emits into messaging-rabbitmq (DlqFailureCauses.g.cs).
    -->
    <ProjectReference Include="..\dlq-failure-metadata-source-gen\D2.Shared.Messaging.DlqMetadata.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Spec files the source-gens read. -->
    <AdditionalFiles Include="..\..\..\..\contracts\mq-messages\mq-messages.spec.json" />
    <AdditionalFiles Include="..\..\..\..\contracts\mq-subscriptions\mq-subscriptions.spec.json" />
    <AdditionalFiles Include="..\..\..\..\contracts\dlq-failure-metadata\dlq-failure-metadata.spec.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="D2.Shared.Messaging.RabbitMq" />
    <InternalsVisibleTo Include="D2.Shared.Tests" />
  </ItemGroup>
</Project>
