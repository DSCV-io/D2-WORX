<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>D2.Shared.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>

    <!--
      Test-project-only warning suppressions. Public-API XML-doc + comment-style
      enforcement remains active for non-test libraries.

      CS1591 (Roslyn) / SA1600 (StyleCop): missing XML doc on public types/members.
      Test method names follow `Method_Scenario_ExpectedResult` which IS the
      documentation; requiring a `summary` echo on every test adds noise.

      SA1512: single-line `//` comments not followed by blank lines. Section
      dividers inside test classes are clearer with a blank line before the next
      test method; SA1512 disagrees. Tests prioritize scan readability over the rule.
    -->
    <!--
      xUnit1051: "use TestContext.Current.CancellationToken on every awaited
      method that accepts a ct" — well-intentioned but exceptionally noisy in
      unit tests that don't model cancellation; xUnit's own timeout already
      bounds runaway tests. Suppressed for clarity.
    -->
    <NoWarn>$(NoWarn);1591;SA1600;SA1512;xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Microsoft.AspNetCore.App framework reference — required so test code can
      construct AspNetCore primitives (DefaultHttpContext, RouteEndpointBuilder,
      EndpointBuilder, IApplicationBuilder for integration tests, etc.) when
      exercising D2.Shared.Auth.Http (and D2.Shared.Auth.Grpc). Adding via
      FrameworkReference (not a PackageReference) follows the AspNetCore
      conventional opt-in.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="JetBrains.Annotations" />
    <!--
      Microsoft.Extensions.{DependencyInjection,Logging,Logging.Abstractions,Hosting}
      packages were previously listed here as explicit PackageReferences. They've
      been removed because the test project now declares a FrameworkReference to
      Microsoft.AspNetCore.App (so it can construct AspNetCore primitives for
      D2.Shared.Auth.Http + D2.Shared.Auth.Grpc tests), and the framework
      reference ships those packages — leaving explicit PackageReferences
      triggers NU1510 ("will not be pruned"). Versions are still pinned via
      Directory.Packages.props.
    -->
    <!--
      Microsoft.CodeAnalysis.CSharp — needed by SrcGen integration tests
      (Unit/Auth/SourceGen, Unit/Context/SourceGen) which drive
      CSharpGeneratorDriver against synthetic compilations. The SrcGen csprojs
      mark this PrivateAssets="all" so it doesn't propagate; tests need an
      explicit reference.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <!-- Testcontainers.Redis — for Integration/Caching/Distributed tests against a real Redis container -->
    <PackageReference Include="Testcontainers.Redis" />
    <!-- Testcontainers.RabbitMq — for Integration/Messaging tests against a real RabbitMQ container -->
    <PackageReference Include="Testcontainers.RabbitMq" />
    <!-- RabbitMQ.Client — for unit tests that need to construct AMQP exception types directly -->
    <PackageReference Include="RabbitMQ.Client" />
    <!-- Microsoft.AspNetCore.TestHost — in-memory web host for end-to-end
         middleware-pipeline tests of D2.Shared.Auth.Http. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <!-- Grpc.Tools — drives protoc + the C# plugin for the test-only
         Protos/d2_test_auth.proto (used by GrpcAuthIntegrationTests). Build-
         only; PrivateAssets="all" so the analyzer / build targets do not flow
         to anything that ProjectReferences this csproj. -->
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Grpc.Net.Client — client-side channel for the in-process integration
         test (constructs a GrpcChannel atop the TestServer's HttpClient). -->
    <PackageReference Include="Grpc.Net.Client" />
    <!-- Google.Protobuf — runtime types (IMessage, IBufferMessage, etc.)
         consumed by the generated proto code; required to compile the
         Grpc.Tools-emitted source files. -->
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="coverlet.msbuild">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\i18n-abstractions\D2.Shared.I18n.Abstractions.csproj" />
    <ProjectReference Include="..\i18n\D2.Shared.I18n.csproj" />
    <!--
      SrcGens (i18n / context / scopes) are referenced as NORMAL libraries
      (not as Analyzers) so the loader / emitter / EmitDiagnostic logic can
      be unit-tested directly. The Tests project does NOT run the generators
      (no AdditionalFiles for messages JSON / spec JSON wired here).
    -->
    <ProjectReference Include="..\i18n-source-gen\D2.Shared.I18n.SourceGen.csproj" />
    <ProjectReference Include="..\auth-scopes-source-gen\D2.Shared.Auth.Scopes.SourceGen.csproj" />
    <ProjectReference Include="..\auth-audiences-source-gen\D2.Shared.Auth.Audiences.SourceGen.csproj" />
    <ProjectReference Include="..\auth-error-codes-source-gen\D2.Shared.Auth.ErrorCodes.SourceGen.csproj" />
    <ProjectReference Include="..\error-codes-source-gen\D2.Shared.Result.ErrorCodes.SourceGen.csproj" />
    <ProjectReference Include="..\d2result-envelope-source-gen\D2.Shared.Result.Envelope.SourceGen.csproj" />
    <ProjectReference Include="..\problem-details-source-gen\D2.Shared.ProblemDetails.SourceGen.csproj" />
    <ProjectReference Include="..\problem-details-abstractions\D2.Shared.ProblemDetails.Abstractions.csproj" />
    <ProjectReference Include="..\wire-shapes-source-gen\D2.Shared.WireShapes.SourceGen.csproj" />
    <ProjectReference Include="..\telemetry-tags-source-gen\D2.Shared.Telemetry.Tags.SourceGen.csproj" Aliases="global,TelemetryTagsSourceGen" />
    <ProjectReference Include="..\context-source-gen\D2.Shared.Context.SourceGen.csproj" />
    <ProjectReference Include="..\headers-source-gen\D2.Shared.Headers.SourceGen.csproj" Aliases="global,HeadersSourceGen" />
    <ProjectReference Include="..\in-process-keys-source-gen\D2.Shared.InProcessKeys.SourceGen.csproj" Aliases="global,InProcessKeysSourceGen" />
    <ProjectReference Include="..\jwt-claims-source-gen\D2.Shared.Auth.JwtClaims.SourceGen.csproj" />
    <ProjectReference Include="..\grpc-trailers-source-gen\D2.Shared.Grpc.Trailers.SourceGen.csproj" />
    <ProjectReference Include="..\otel-messaging-tags-source-gen\D2.Shared.OtelMessagingTags.SourceGen.csproj" />
    <ProjectReference Include="..\encryption-domains-source-gen\D2.Shared.EncryptionDomains.SourceGen.csproj" />
    <ProjectReference Include="..\encryption-frame-source-gen\D2.Shared.EncryptionFrame.SourceGen.csproj" />
    <ProjectReference Include="..\dlq-failure-metadata-source-gen\D2.Shared.Messaging.DlqMetadata.SourceGen.csproj" />
    <ProjectReference Include="..\resilience\D2.Shared.Resilience.csproj" />
    <ProjectReference Include="..\result\D2.Shared.Result.csproj" />
    <ProjectReference Include="..\utilities\D2.Shared.Utilities.csproj" />
    <ProjectReference Include="..\aspnetcore\D2.Shared.AspNetCore.csproj" />
    <ProjectReference Include="..\auth\D2.Shared.Auth.csproj" />
    <ProjectReference Include="..\auth-abstractions\D2.Shared.Auth.Abstractions.csproj" />
    <ProjectReference Include="..\auth-http\D2.Shared.Auth.Http.csproj" />
    <ProjectReference Include="..\auth-grpc\D2.Shared.Auth.Grpc.csproj" />
    <ProjectReference Include="..\auth-context-abstractions\D2.Shared.AuthContext.Abstractions.csproj" />
    <ProjectReference Include="..\auth-outbound\D2.Shared.Auth.Outbound.csproj" />
    <ProjectReference Include="..\context-abstractions\D2.Shared.Context.Abstractions.csproj" />
    <ProjectReference Include="..\handler-abstractions\D2.Shared.Handler.Abstractions.csproj" />
    <ProjectReference Include="..\handler\D2.Shared.Handler.csproj" />
    <ProjectReference Include="..\handler-repo-abstractions\D2.Shared.Handler.Repo.Abstractions.csproj" />
    <ProjectReference Include="..\handler-repo\D2.Shared.Handler.Repo.csproj" />
    <ProjectReference Include="..\handler-repo-postgres\D2.Shared.Handler.Repo.Postgres.csproj" />
    <ProjectReference Include="..\encryption\D2.Shared.Encryption.csproj" />
    <ProjectReference Include="..\caching-abstractions\D2.Shared.Caching.Abstractions.csproj" />
    <ProjectReference Include="..\caching-local-default\D2.Shared.Caching.Local.Default.csproj" />
    <ProjectReference Include="..\caching-distributed-redis\D2.Shared.Caching.Distributed.Redis.csproj" />
    <ProjectReference Include="..\caching-tiered\D2.Shared.Caching.Tiered.csproj" />
    <ProjectReference Include="..\logging\D2.Shared.Logging.csproj" />
    <ProjectReference Include="..\telemetry\D2.Shared.Telemetry.csproj" />
    <ProjectReference Include="..\time\D2.Shared.Time.csproj" />
    <ProjectReference Include="..\service-defaults\D2.Shared.ServiceDefaults.csproj" />
    <ProjectReference Include="..\messaging-abstractions\D2.Shared.Messaging.Abstractions.csproj" />
    <ProjectReference Include="..\messaging-rabbitmq\D2.Shared.Messaging.RabbitMq.csproj" />
    <ProjectReference Include="..\headers-common\D2.Shared.Headers.Common.csproj" />
    <ProjectReference Include="..\headers-http\D2.Shared.Headers.Http.csproj" />
    <ProjectReference Include="..\headers-amqp\D2.Shared.Headers.Amqp.csproj" />
    <ProjectReference Include="..\headers-grpc\D2.Shared.Headers.Grpc.csproj" />
    <!--
      D2.Shared.Geo.Abstractions — the contract-fixtures parity emitters
      (GeoEnumsFixtureEmitter / GeoWrapperStructsFixtureEmitter /
      GeoCatalogFixtureEmitter) reflect on the codegen-emitted enums +
      wrapper structs + GeoCatalog constants to write the canonical JSON
      fixtures the TS-side parity tests load.
    -->
    <ProjectReference Include="..\geo-abstractions\D2.Shared.Geo.Abstractions.csproj" />
    <!--
      D2.Shared.Geo.Default — catalog data + DefaultGeoNameResolver +
      Default-layer record-returning IRequestContext extensions. Tests
      exercise the resolver cascade, cache-aside discipline, DI
      composition, and the Default-layer extension boundary contract.
      Internal helpers (CacheEntry structs, cache field accessors) are
      reachable from this project via the InternalsVisibleTo declaration
      on D2.Shared.Geo.Default.
    -->
    <ProjectReference Include="..\geo-default\D2.Shared.Geo.Default.csproj" />
    <!--
      D2.Shared.Location — Coordinates, StreetAddress, AdminLocation value objects +
      hash composer + postal-code validator. Tests exercise all three VO
      smart-constructors, the canonical geohash-10 normalization pipeline, and the
      GeohashEncoder / PlusCodeEncoder internal helpers (visible via InternalsVisibleTo).
    -->
    <ProjectReference Include="..\location\D2.Shared.Location.csproj" />
    <!--
      D2.Shared.Geo.SourceGen — Roslyn IIncrementalGenerator that emits the
      geo-default lookup data + GeoDataInitializer coordinator. Tests cover
      the per-emitter EmitAll() output shape (snapshot-style assertions over
      the emitted source string) against synthetic GeoSpecContext inputs.
      Internal record/method visibility is reached via the
      InternalsVisibleTo declaration on D2.Shared.Geo.SourceGen.
      Build-only — analyzer/build assets do NOT propagate to consumers of
      this csproj (consistent with the other source-gen project references).
    -->
    <ProjectReference Include="..\geo-source-gen\D2.Shared.Geo.SourceGen.csproj" />
  </ItemGroup>

  <!--
    Test-only proto file driving the D2.Shared.Auth.Grpc end-to-end integration
    test (GrpcAuthIntegrationTests). Compiled in Both mode (server base class
    + client stub) so the test can host the service via MapGrpcService<T>() AND
    dial it via the generated client. NOT a wire contract — strictly internal
    to the test project; lives under Protos/ alongside other test fixtures.
  -->
  <ItemGroup>
    <Protobuf Include="Protos\d2_test_auth.proto" GrpcServices="Both" />
  </ItemGroup>
</Project>
