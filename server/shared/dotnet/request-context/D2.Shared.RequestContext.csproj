<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>D2.Shared.RequestContext</RootNamespace>

    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <!--
    Mutable concrete (MutableRequestContext) + cross-transport envelope record
    (ContextEnvelope) — codegen-emitted from contracts/{auth,request}-context
    specs by D2.Shared.Context.SourceGen. Plus hand-written parsers for the two
    structured JWT claims:
      * ActorChainParser — RFC 8693 §2.1 nested actor chain
      * ScopeClaimParser — RFC 6749 §3.3 scope string OR JSON array

    System.Security.Claims (ClaimsPrincipal) and System.Text.Json (JsonElement)
    are BCL — no extra package refs needed.
  -->

  <ItemGroup>
    <ProjectReference Include="..\request-context-abstractions\D2.Shared.RequestContext.Abstractions.csproj" />
    <ProjectReference Include="..\auth-context-abstractions\D2.Shared.AuthContext.Abstractions.csproj" />
    <ProjectReference Include="..\auth-abstractions\D2.Shared.Auth.Abstractions.csproj" />
    <ProjectReference Include="..\utilities\D2.Shared.Utilities.csproj" />
    <ProjectReference Include="..\context-source-gen\D2.Shared.Context.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\..\..\..\contracts\auth-context\IAuthContext.spec.json" />
    <AdditionalFiles Include="..\..\..\..\contracts\request-context\IRequestContext.spec.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="D2.Shared.Tests" />
  </ItemGroup>
</Project>
