<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>D2.Shared.ServiceDefaults</RootNamespace>
    <!--
      Sdk.Web defaults OutputType to Exe (intended for runnable web apps);
      explicit Library override since this is a shared library, NOT an app
      entry point. Sdk.Web is preferred over plain Sdk because it brings the
      AspNetCore framework reference automatically — every public surface in
      this lib touches AspNetCore types (IApplicationBuilder for the
      pipeline aggregator, IEndpointRouteBuilder for the endpoint aggregator,
      WebApplication for the RunD2ServiceAsync re-export, IServiceCollection
      for the DI aggregator). Mirrors sibling D2.Shared.AspNetCore +
      D2.Shared.Logging + D2.Shared.Telemetry csproj.
    -->
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <!--
    D2.Shared.ServiceDefaults — pure thin aggregator. ZERO logic. Owns four
    public extension methods (AddD2ServiceDefaults, UseD2DefaultPipeline,
    MapD2DefaultEndpoints, RunD2ServiceAsync) that wire every prior shared
    lib into a single composition surface, so per-service Program.cs shrinks
    from ~60-150 lines of Serilog / OTel / health / CORS / ProblemDetails /
    startup-wrapper boilerplate to ~10-15 lines of service-specific
    declarations. Every behavior is owned by a logic-bearing prior-step lib
    — this csproj has no internal classes, no middleware impls, no helpers.

    Project references (the canonical 10):
      • D2.Shared.Logging                 — Serilog + redaction + request logging
      • D2.Shared.Telemetry               — OTel SDK + exporters + Prometheus endpoint
      • D2.Shared.AspNetCore              — Security headers, CORS, ProblemDetails,
                                            health checks, infrastructure bypass,
                                            RunD2ServiceAsync startup wrapper
      • D2.Shared.I18n                    — SupportedLocales + ITranslator
      • D2.Shared.Handler                 — HandlerContext open-generic registration
      • D2.Shared.Auth                    — JwtValidator, JWKS provider, sessions
      • D2.Shared.Auth.Http               — JwtAuthMiddleware + scoped IRequestContext
      • D2.Shared.Auth.Grpc               — JwtAuthInterceptor + scoped IRequestContext
      • D2.Shared.Caching.Local.Default   — In-process L1 cache (DefaultLocalCache)
      • D2.Shared.Utilities               — D2Env.Load() + Falsey()/Truthy() extensions

    Does NOT own (per the locked design):
      • Encryption                        — D2.Shared.Encryption (per-domain opt-in)
      • Distributed cache                 — D2.Shared.Caching.Distributed.Redis (opt-in)
      • Tiered cache                      — D2.Shared.Caching.Tiered (opt-in)
      • PostgreSQL                        — D2.Shared.Handler.Repo.Postgres (opt-in)
      • RabbitMQ                          — D2.Shared.Messaging.RabbitMq (opt-in)
      • Outbound auth                     — D2.Shared.Auth.Outbound (opt-in)
  -->

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
    <!--
      Microsoft.Extensions.Http.Resilience — provides AddStandardResilienceHandler()
      for ConfigureHttpClientDefaults. Not transitively present from any of the 10
      ProjectRefs above (verified via grep: only Microsoft.Extensions.Http is
      transitively pulled by D2.Shared.Auth.Outbound; Resilience is a separate
      package). Adding explicitly here so AddD2ServiceDefaults can wire the
      retry + circuit-break + timeout handler for ALL named HttpClients in the
      host. Documented as §13.13 reconciliation in the step's journal.
    -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\aspnetcore\D2.Shared.AspNetCore.csproj" />
    <ProjectReference Include="..\auth\core\D2.Shared.Auth.csproj" />
    <ProjectReference Include="..\auth\grpc\D2.Shared.Auth.Grpc.csproj" />
    <ProjectReference Include="..\auth\http\D2.Shared.Auth.Http.csproj" />
    <!--
      auth/startup — deny-by-default boot guard (AuthEndpointGuardStartupCheck +
      AddD2AuthEndpointGuard). Wired via AddD2AuthEndpointGuard() in the
      SkipAuthAutoWiring=false path when SkipAuthEndpointGuard=false (the default).
      Not included in the original 10-lib aggregator list — added as the 11th ref
      for the guard; all behavior still lives in auth/startup, not here.
    -->
    <ProjectReference Include="..\auth\startup\D2.Shared.Auth.Startup.csproj" />
    <ProjectReference Include="..\caching\local-default\D2.Shared.Caching.Local.Default.csproj" />
    <ProjectReference Include="..\handler\core\D2.Shared.Handler.csproj" />
    <ProjectReference Include="..\i18n\core\D2.Shared.I18n.csproj" />
    <ProjectReference Include="..\logging\D2.Shared.Logging.csproj" />
    <ProjectReference Include="..\telemetry\core\D2.Shared.Telemetry.csproj" />
    <ProjectReference Include="..\utilities\D2.Shared.Utilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="D2.Shared.Tests" />
  </ItemGroup>
</Project>
