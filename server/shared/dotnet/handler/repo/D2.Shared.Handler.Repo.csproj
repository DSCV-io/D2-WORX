<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>D2.Shared.Handler.Repo</RootNamespace>
  </PropertyGroup>

  <!--
    EF-flavored handler base. Sits on top of D2.Shared.Handler's BaseHandler
    and converts captured exceptions into typed D2Result failures via an
    injected IDbExceptionClassifier. Provider-specific knowledge lives in
    sibling packages (e.g. D2.Shared.Handler.Repo.Postgres) — this csproj
    intentionally has zero provider deps.
  -->

  <ItemGroup>
    <ProjectReference Include="..\core\D2.Shared.Handler.csproj" />
    <ProjectReference Include="..\abstractions\D2.Shared.Handler.Abstractions.csproj" />
    <ProjectReference Include="..\repo-abstractions\D2.Shared.Handler.Repo.Abstractions.csproj" />
    <ProjectReference Include="..\..\result\core\D2.Shared.Result.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="D2.Shared.Tests" />
  </ItemGroup>
</Project>
