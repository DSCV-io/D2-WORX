<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>D2.Shared.Auth.Abstractions</RootNamespace>

    <!-- Emit the generator's output (Scopes.g.cs) to obj/Generated/ so it's
         visible for inspection / debugging (Rider also picks them up). -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <!--
    Zero external deps by design. This is the identity / authorization vocabulary
    slice that domain code, request-context, handler-abstractions, and the runtime
    D2.Shared.Auth all reference for shared enums and string constants.

    Two sibling Roslyn analyzers contribute generated code to this assembly:

      - D2.Shared.Auth.Scopes.SourceGen (../auth-scopes-source-gen/) →
        Scopes.g.cs, driven by contracts/auth-scopes/scopes.spec.json
      - D2.Shared.Auth.Audiences.SourceGen (../auth-audiences-source-gen/) →
        Audiences.g.cs, driven by contracts/auth-audiences/audiences.spec.json

    Both reference below with OutputItemType="Analyzer" (no runtime dll dep).
  -->

  <ItemGroup>
    <ProjectReference Include="..\auth-scopes-source-gen\D2.Shared.Auth.Scopes.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\auth-audiences-source-gen\D2.Shared.Auth.Audiences.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Surface the spec files to the source generators. Single source of truth
      for both the platform's scope catalog and audience catalog.
    -->
    <AdditionalFiles Include="..\..\..\..\contracts\auth-scopes\scopes.spec.json" />
    <AdditionalFiles Include="..\..\..\..\contracts\auth-audiences\audiences.spec.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="D2.Shared.Tests" />
  </ItemGroup>
</Project>
