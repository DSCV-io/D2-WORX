<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>D2.Shared.RequestContext.Abstractions</RootNamespace>

    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <!--
    Per-request runtime context interface (extends IAuthContext with transport
    + network + fingerprint + WhoIs sections). Codegen-emitted from
    contracts/request-context/IRequestContext.spec.json by D2.Shared.Context.SourceGen.

    This is the read-only contract handlers and middleware code consume. The
    mutable concrete + envelope record live in the sibling D2.Shared.RequestContext
    project; transport-specific filling extensions live in their respective libs
    (handler-aspnetcore for HTTP, handler-messaging for AMQP).
  -->

  <ItemGroup>
    <ProjectReference Include="..\auth-context-abstractions\D2.Shared.AuthContext.Abstractions.csproj" />
    <ProjectReference Include="..\context-source-gen\D2.Shared.Context.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\..\..\..\contracts\auth-context\IAuthContext.spec.json" />
    <AdditionalFiles Include="..\..\..\..\contracts\request-context\IRequestContext.spec.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="D2.Shared.Tests" />
  </ItemGroup>
</Project>
