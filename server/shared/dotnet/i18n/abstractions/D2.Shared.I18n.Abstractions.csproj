<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>D2.Shared.I18n</RootNamespace>

    <!-- Emit the generator's output (TK.g.cs) to <project-dir>/Generated/.
         The directory is tracked in git so PR reviewers see codegen diffs
         without a local build. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The SourceGen pipeline feeds the in-memory compiler with the same content
      that lands on disk under Generated/. Without this Remove, the SDK-default
      <Compile Include="**/*.cs" /> glob picks up the on-disk copy and the build
      fails with duplicate-definition errors (CS0101 / CS0111). See:
      https://learn.microsoft.com/dotnet/core/project-sdk/msbuild-props#compilergeneratedfilesoutputpath
    -->
    <Compile Remove="$(CompilerGeneratedFilesOutputPath)\**\*.cs" />
  </ItemGroup>

  <!--
    Zero non-BCL deps by design. This project is the domain-safe slice
    that domain layers can reference without dragging in DI / Configuration / IO.

    The runtime D2.Shared.I18n (Translator + SupportedLocales + AddD2I18n)
    is a separate sibling project that consumes this and adds the infra.

    The TK constants in this assembly are emitted at build time by the
    sibling D2.Shared.I18n.SourceGen project (../source-gen/),
    referenced below as a Roslyn analyzer (no runtime dll dependency).
  -->

  <ItemGroup>
    <ProjectReference Include="..\source-gen\D2.Shared.I18n.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <!--
      D2.Shared.WireShapes.SourceGen reads tk-message.spec.json via
      AdditionalFiles below and emits TkMessageWireShape.g.cs into this
      assembly (per-assembly dispatch table in WireShapesGenerator.cs).
      The emitted KEY / PARAMS constants replace inline string literals
      in TKMessageJsonConverter so the .NET serializer and the TS-side
      parser reference byte-equal property names.
    -->
    <ProjectReference Include="..\..\source-gen-shared\wire-shapes-source-gen\D2.Shared.WireShapes.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Surface the contracts/messages JSON files to the source generator.
      The generator reads en-US.json (source of truth) to emit the TK class
      and reads the rest for per-locale coverage diagnostics.
    -->
    <AdditionalFiles Include="$(D2ContractsRoot)messages\*.json" />
    <!--
      Surface tk-message.spec.json to D2.Shared.WireShapes.SourceGen. The
      generator dispatches on assembly name (D2.Shared.I18n.Abstractions
      → TkMessageWireShape.g.cs) and emits a static class carrying the
      KEY / PARAMS property-name constants.
    -->
    <AdditionalFiles Include="$(D2ContractsRoot)tk-message\tk-message.spec.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="D2.Shared.I18n" />
    <InternalsVisibleTo Include="D2.Shared.Tests" />
  </ItemGroup>
</Project>
