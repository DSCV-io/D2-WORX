<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>D2.Shared.Auth.Outbound</RootNamespace>
    <!--
      Emit the SrcGen-emitted OutboundTelemetryTags.g.cs (driven by the
      telemetry/tags-source-gen analyzer wired below) plus the framework
      LoggerMessage.g.cs to <project-dir>/Generated/. The directory is tracked
      in git so PR reviewers see codegen diffs without a local build.
    -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The SourceGen pipeline feeds the in-memory compiler with the same content
      that lands on disk under Generated/. Without this Remove, the SDK-default
      <Compile Include="**/*.cs" /> glob picks up the on-disk copy and the build
      fails with duplicate-definition errors (CS0101 / CS0111). See:
      https://learn.microsoft.com/dotnet/core/project-sdk/msbuild-props#compilergeneratedfilesoutputpath
    -->
    <Compile Remove="$(CompilerGeneratedFilesOutputPath)\**\*.cs" />
  </ItemGroup>

  <!--
    Outbound auth runtime — service-identity (client_credentials) + token-exchange
    (RFC 8693) + the per-channel gRPC opt-in (.AddD2ServiceIdentity()) for attaching
    a service-identity Bearer to outbound D² gRPC calls.

    Discovery is OIDC-canonical: D2_AUTH_ISSUER → /.well-known/openid-configuration →
    token_endpoint via Microsoft.IdentityModel.Protocols.OpenIdConnect's
    ConfigurationManager<OpenIdConnectConfiguration>.
  -->

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
  </ItemGroup>

  <ItemGroup>
    <!--
      auth-abstractions — Audiences (codegen'd const URLs), JwtClaimTypes (claim name
      constants codegen'd from contracts/jwt-claims/jwt-claims.spec.json).
      Outbound-side audience targeting flows through the Audiences.* constants.
      HTTP request-header constants live in D2.Shared.Headers.Http.
    -->
    <ProjectReference Include="..\abstractions\D2.Shared.Auth.Abstractions.csproj" />
    <!--
      auth-context-abstractions / context\abstractions — for IRequestContext +
      MutableRequestContext.FromJwtPayloadNoValidation (used by TokenExchangeClient
      to extract d2_session_id from the inbound subject token for cache keying).
    -->
    <ProjectReference Include="..\context-abstractions\D2.Shared.AuthContext.Abstractions.csproj" />
    <ProjectReference Include="..\..\context\abstractions\D2.Shared.Context.Abstractions.csproj" />
    <!--
      caching-abstractions — TokenExchangeCache writes through the shared ILocalCache
      singleton with a 'tokenexchange:' key prefix. Backplane subscription drives
      session-revoked invalidation.
    -->
    <ProjectReference Include="..\..\caching\abstractions\D2.Shared.Caching.Abstractions.csproj" />
    <!--
      resilience — Singleflight on cache-miss / refresh paths to dedup concurrent
      token requests. CircuitBreaker / RetryPolicy attach to the named HttpClient.
    -->
    <ProjectReference Include="..\..\resilience\D2.Shared.Resilience.csproj" />
    <ProjectReference Include="..\..\result\core\D2.Shared.Result.csproj" />
    <ProjectReference Include="..\..\i18n\abstractions\D2.Shared.I18n.Abstractions.csproj" />
    <ProjectReference Include="..\..\utilities\D2.Shared.Utilities.csproj" />
    <!--
      headers-grpc — codegen-emitted gRPC metadata-key constants
      (GrpcHeaders.AUTHORIZATION etc.). Consumed by
      ServiceIdentityCallCredentials when attaching the service-identity
      Bearer token to outbound RPCs. Single spec-driven catalog shared with
      the TS-side @d2/grpc-* packages so wire-protocol header names are
      byte-identical across .NET and Node.
    -->
    <ProjectReference Include="..\..\headers\grpc\D2.Shared.Headers.Grpc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Telemetry-tags SrcGen — single-targets per the spec's consumingAssembly
      field. Emits OutboundTelemetryTags.g.cs into this assembly. Spec file
      is shared with D2.Shared.Auth's wiring; SrcGen reads it once per
      compilation tick.
    -->
    <ProjectReference Include="..\..\telemetry\tags-source-gen\D2.Shared.Telemetry.Tags.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="$(D2ContractsRoot)telemetry\telemetry.spec.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="D2.Shared.Tests" />
  </ItemGroup>
</Project>
