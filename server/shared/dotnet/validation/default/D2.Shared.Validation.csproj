<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>D2.Shared.Validation</RootNamespace>
  </PropertyGroup>

  <!--
    Default validator implementations for the three D2.Shared.Validation.Abstractions
    contracts: email (regex), phone (libphonenumber-csharp), and postal code
    (per-country regex map loaded from an embedded JSON dataset ported from
    postcode-validator@3.10.9). All three validators are stateless and singleton-safe.

    Pull in Microsoft.Extensions.DependencyInjection.Abstractions for the
    AddValidation() DI extension, and libphonenumber-csharp for phone-number
    parsing + E.164 formatting.
  -->
  <ItemGroup>
    <!--
      Microsoft.Extensions.DependencyInjection.Abstractions — IServiceCollection
      receiver for the AddValidation() registration extension.
    -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!--
      libphonenumber-csharp — Apache-2.0. PhoneNumberUtil.GetInstance() parses
      and validates international + national-format numbers, then formats to E.164.
    -->
    <PackageReference Include="libphonenumber-csharp" />
  </ItemGroup>

  <ItemGroup>
    <!--
      D2.Shared.Validation.Abstractions — the three validator contracts this
      project implements (IEmailValidator, IPhoneValidator, IPostalCodeValidator).
    -->
    <ProjectReference Include="..\abstractions\D2.Shared.Validation.Abstractions.csproj" />
    <!--
      D2.Shared.Result — D2Result<string> semantic factories (Ok, ValidationFailed)
      returned by every Validate() method.
    -->
    <ProjectReference Include="..\..\result\core\D2.Shared.Result.csproj" />
    <!--
      D2.Shared.Geo.Abstractions — CountryCode enum (alpha-2 backed) used by
      IPhoneValidator (defaultRegion) and IPostalCodeValidator (countryCode).
    -->
    <ProjectReference Include="..\..\geo\abstractions\D2.Shared.Geo.Abstractions.csproj" />
    <!--
      D2.Shared.Utilities — Falsey()/Truthy() null+empty+whitespace guards
      used by all three validators on their input parameters.
    -->
    <ProjectReference Include="..\..\utilities\D2.Shared.Utilities.csproj" />
    <!--
      D2.Shared.I18n — TK.Common.Validation.* translation-key constants
      carried in the per-field InputError.Errors lists on validation failures.
    -->
    <ProjectReference Include="..\..\i18n\abstractions\D2.Shared.I18n.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Postal-code regex map — sourced from postcode-validator@3.10.9 (npm).
      Embedded so the data travels with the assembly without a file-system
      dependency at runtime.
    -->
    <EmbeddedResource Include="PostalCodeRegexData.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="D2.Shared.Tests" />
  </ItemGroup>
</Project>
