<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>D2.Shared.Validation.Abstractions</RootNamespace>
  </PropertyGroup>

  <!--
    DI-free interface library. Domain code anywhere in the backend can
    take a ProjectReference here without pulling in a DI container,
    phone-number library, or geo catalog data. The surface is
    intentionally minimal — three validator contracts and nothing else.

    NO Microsoft.Extensions.DependencyInjection reference.
    NO implementation code — implementations live in D2.Shared.Validation.
  -->
  <ItemGroup>
    <!--
      D2.Shared.Result — all three validator interfaces return D2Result<string>
      so callers can branch on Success / ValidationFailed and surface field-level
      InputErrors via the standard envelope.
    -->
    <ProjectReference Include="..\..\result\core\D2.Shared.Result.csproj" />
    <!--
      D2.Shared.Geo.Abstractions — CountryCode is used by IPhoneValidator
      (defaultRegion) and IPostalCodeValidator (countryCode) to scope
      national-format interpretation and country-specific format rules.
    -->
    <ProjectReference Include="..\..\geo\abstractions\D2.Shared.Geo.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="D2.Shared.Tests" />
  </ItemGroup>
</Project>
