<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>D2.Shared.Caching</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Result + I18n.Abstractions are zero-runtime-dep / domain-safe so this
      abstractions slice stays the same. Every cache op returns D2Result<T>
      so callers compose with the rest of the codebase's errors-as-values
      pattern; tier failures land as PartialSuccess (writes) or NotFound /
      SomeFound (reads).
    -->
    <ProjectReference Include="..\..\result\core\D2.Shared.Result.csproj" />
    <ProjectReference Include="..\..\i18n\abstractions\D2.Shared.I18n.Abstractions.csproj" />
  </ItemGroup>
</Project>
