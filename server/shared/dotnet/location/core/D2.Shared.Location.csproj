<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>D2.Shared.Location</RootNamespace>
  </PropertyGroup>

  <!--
    Pure-domain location value objects (Coordinates, StreetAddress, AdminLocation),
    hash composer, and postal-code validator interface + default implementation.
    Depends on D2.Shared.Geo.Abstractions (typed code enums + wrapper structs),
    D2.Shared.Result (D2Result<T> factories), D2.Shared.Utilities (Falsey/Truthy
    + string cleaning + NormalizeForHash helpers), and D2.Shared.Validation.Abstractions
    (FieldConstraints length caps consumed by VO Create gates).
    NO D2.Shared.Geo.Default, NO NodaTime — keeps Location pure-domain without
    dragging the ~200KB catalog or any temporal-runtime cost.
  -->
  <ItemGroup>
    <!--
      Microsoft.Extensions.DependencyInjection.Abstractions — IServiceCollection
      receiver for the AddD2Location registration extension.
    -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!--
      D2.Shared.Geo.Abstractions — typed CountryCode enum + SubdivisionCode wrapper
      struct (including SubdivisionCode.ParentCountry) that AdminLocation references.
    -->
    <ProjectReference Include="..\..\geo\abstractions\D2.Shared.Geo.Abstractions.csproj" />
    <!--
      D2.Shared.Result — D2Result<T> semantic factories (Ok, ValidationFailed, etc.)
      used by all three VO smart-constructors and IPostalCodeValidator.
    -->
    <ProjectReference Include="..\..\result\core\D2.Shared.Result.csproj" />
    <!--
      D2.Shared.Utilities — Falsey()/Truthy() guards + CleanStr() string helpers
      used in VO validation and normalization pipelines.
    -->
    <ProjectReference Include="..\..\utilities\D2.Shared.Utilities.csproj" />
    <!--
      D2.Shared.Validation.Abstractions — FieldConstraints length caps
      (STREET_LINE_MAX, CITY_MAX, POSTAL_CODE_MAX) consumed by the VO
      Create gates. Cycle-free: Validation.Abstractions depends only on
      D2.Shared.Result + D2.Shared.Geo.Abstractions — it does NOT depend
      on D2.Shared.Location.
    -->
    <ProjectReference Include="..\..\validation\abstractions\D2.Shared.Validation.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="D2.Shared.Tests" />
  </ItemGroup>
</Project>
