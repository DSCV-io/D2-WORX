<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>D2.Shared.Utilities</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="dotenv.net" />
    <PackageReference Include="JetBrains.Annotations" />
    <!--
      PublicApiAnalyzers — public API surface tracking for the versioning-engine spike.
      Scoped to this csproj only; NOT enabled globally.
      RS0016: new public API absent from Shipped/Unshipped → flag for versioning engine.
      RS0017: public API removed from source but still listed in Shipped → breaking change.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- PublicAPI baseline files for the analyzer. PublicAPI.Shipped.txt contains the
         committed public API baseline; PublicAPI.Unshipped.txt accumulates new/removed
         APIs since the last baseline snapshot. Both start empty; running the
         RS0016 bulk-fix populates Unshipped.txt, then Unshipped is promoted to Shipped
         to seed the baseline. -->
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <!--
      D2.Shared.Result + D2.Shared.I18n.Abstractions enable Utilities to expose
      D2Result-returning validators (TryParseEmail / TryParsePhoneNumber) that
      domain layers can chain into smart-constructor factories. Both deps are
      zero-runtime-dep / domain-safe — Utilities stays so too.
    -->
    <ProjectReference Include="..\result\core\D2.Shared.Result.csproj" />
    <ProjectReference Include="..\i18n\abstractions\D2.Shared.I18n.Abstractions.csproj" />
    <ProjectReference Include="..\i18n\keys\D2.Shared.I18n.Keys.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="D2.Shared.Tests" />
  </ItemGroup>

  <!-- Publish metadata (per-package semver + NuGet identity). -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <PackageId>D2.Shared.Utilities</PackageId>
    <Description>Foundational boundary helpers for D2-WORX — Falsey/Truthy semantics, string cleaning, parse-or-default extensions, indexed env-var parsing, and JSON-cycle-safe serialization.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
