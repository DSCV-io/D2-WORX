<Solution>
  <!--
    D²-WORX v2 solution (modern XML format, .NET 10).
    Projects are added here per V2 phasing (see docs/v2/PHASE_0.md while it exists).

    Phase 0 will populate this with the foundational shared libraries
    (D2.Shared.Handler, D2.Shared.Result, D2.Shared.Utilities, etc.).
  -->
  <Folder Name="/shared/" />
  <Folder Name="/shared/dotnet/" />
  <Folder Name="/shared/dotnet/i18n/">
    <Project Path="shared/dotnet/i18n/D2.Shared.I18n.csproj" />
  </Folder>
  <Folder Name="/shared/dotnet/i18n-abstractions/">
    <Project Path="shared/dotnet/i18n-abstractions/D2.Shared.I18n.Abstractions.csproj" />
    <Project Path="shared/dotnet/i18n-abstractions/source-gen/D2.Shared.I18n.SourceGen.csproj" />
  </Folder>
  <Folder Name="/shared/dotnet/resilience/">
    <Project Path="shared/dotnet/resilience/D2.Shared.Resilience.csproj" />
  </Folder>
  <Folder Name="/shared/dotnet/result/">
    <Project Path="shared/dotnet/result/D2.Shared.Result.csproj" />
  </Folder>
  <Folder Name="/shared/dotnet/tests/">
    <Project Path="shared/dotnet/tests/D2.Shared.Tests.csproj" />
  </Folder>
  <Folder Name="/shared/dotnet/utilities/">
    <Project Path="shared/dotnet/utilities/D2.Shared.Utilities.csproj" />
  </Folder>
</Solution>
