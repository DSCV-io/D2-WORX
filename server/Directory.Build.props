<Project>
  <!--
    Universal properties applied to every .csproj in the solution.
    Per-project files only need to declare RootNamespace (and any project-specific
    properties like IsTestProject / Sdk overrides for Web projects).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Build gates: every warning is a build-failure. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Emit XML doc files; combined with TreatWarningsAsErrors this enforces
         CS1591 (missing XML doc on public API) per CLAUDE.md "XML docs: Required
         for public APIs". -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Solution-relative path properties. csprojs reference these instead of dot-counted relative paths
       so folder nesting depth can change without breaking manifest path references.
       MSBuildThisFileDirectory resolves to <repo>\server\ from this file's location; .. +
       NormalizeDirectory yields the repo root with trailing separator. -->
  <PropertyGroup>
    <D2RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..'))</D2RepoRoot>
    <D2ContractsRoot>$(D2RepoRoot)contracts\</D2ContractsRoot>
    <D2SharedDotnetRoot>$(D2RepoRoot)server\shared\dotnet\</D2SharedDotnetRoot>
    <D2SourceGenSharedRoot>$(D2SharedDotnetRoot)source-gen-shared\core\</D2SourceGenSharedRoot>
    <D2ErrorCodesEmitRoot>$(D2SharedDotnetRoot)source-gen-shared\error-codes-emit\</D2ErrorCodesEmitRoot>
    <D2ToolsRoot>$(D2RepoRoot)tools\</D2ToolsRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" />
  </ItemGroup>

  <!-- Global usings for all projects -->
  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>
</Project>