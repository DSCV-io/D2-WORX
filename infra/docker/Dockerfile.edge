# =============================================================================
# Dockerfile.edge — D2.Edge.Api (composition root)
# Build context: repo root
# Targets:
#   prod — published bits on aspnet runtime (no source mount, no watch)
#   dev  — SDK + dotnet watch (Compose Watch sync; see compose.dev.yml)
# =============================================================================

# --- Build (prod) ---
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY server/Directory.Build.props server/Directory.Packages.props server/D2.slnx server/stylecop.json ./server/
# Repo-root editorconfig — StyleCop / analyzers resolve from /src/server upward.
COPY .editorconfig ./
# Service-tree global usings (D2Result / RedactData / Utilities) — MSBuild walks up to services/.
COPY server/services/Directory.Build.targets ./server/services/
COPY server/shared/dotnet ./server/shared/dotnet
COPY server/services/edge ./server/services/edge
COPY server/services/audit/clients ./server/services/audit/clients
# Audit.Client Grpc.Tools imports protos owned by Audit.Api (compile-once / AdditionalImportDirs).
COPY server/services/audit/api/Protos ./server/services/audit/api/Protos
COPY contracts ./contracts
COPY tools/loggermessage-splitter ./tools/loggermessage-splitter

RUN dotnet restore server/services/edge/api/D2.Edge.Api.csproj
RUN dotnet publish server/services/edge/api/D2.Edge.Api.csproj \
    -c Release -o /app/publish --no-restore

# --- Prod runtime ---
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS prod
WORKDIR /app

# Explicit health probe — aspnet base has no curl; install wget for compose healthcheck.
RUN apt-get update \
    && apt-get install -y --no-install-recommends wget \
    && rm -rf /var/lib/apt/lists/*

ENV ASPNETCORE_URLS=
ENV DOTNET_EnableDiagnostics=0

COPY --from=build /app/publish .

EXPOSE 8080 8443 9443

# Prefer wget (installed above) — never assume curl on aspnet.
HEALTHCHECK --interval=10s --timeout=5s --retries=5 --start-period=30s \
  CMD wget -qO- http://127.0.0.1:8080/health || exit 1

ENTRYPOINT ["dotnet", "D2.Edge.Api.dll"]

# --- Dev: SDK + watch (source synced via compose.dev.yml develop.watch) ---
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS dev
WORKDIR /src

RUN apt-get update \
    && apt-get install -y --no-install-recommends wget \
    && rm -rf /var/lib/apt/lists/*

ENV ASPNETCORE_URLS=
ENV DOTNET_USE_POLLING_FILE_WATCHER=1
ENV DOTNET_EnableDiagnostics=0

COPY server/Directory.Build.props server/Directory.Packages.props server/D2.slnx server/stylecop.json ./server/
COPY .editorconfig ./
COPY server/services/Directory.Build.targets ./server/services/
COPY server/shared/dotnet ./server/shared/dotnet
COPY server/services/edge ./server/services/edge
COPY server/services/audit/clients ./server/services/audit/clients
COPY server/services/audit/api/Protos ./server/services/audit/api/Protos
COPY contracts ./contracts
COPY tools/loggermessage-splitter ./tools/loggermessage-splitter

RUN dotnet restore server/services/edge/api/D2.Edge.Api.csproj

EXPOSE 8080 8443 9443

HEALTHCHECK --interval=10s --timeout=5s --retries=5 --start-period=60s \
  CMD wget -qO- http://127.0.0.1:8080/health || exit 1

ENTRYPOINT ["dotnet", "watch", "run", "--project", "server/services/edge/api/D2.Edge.Api.csproj", "--no-launch-profile"]
