# =============================================================================
# Dockerfile.audit — DcsvIo.D2.Private.Audit.Api (standalone stub host)
# Build context: repo root
# Targets:
#   prod — published bits on aspnet runtime (no source mount, no watch)
#   dev  — SDK + dotnet watch (Compose Watch sync; see compose.dev.yml)
#
# Monorepo dual-root layout under /src (see Dockerfile.edge).
# =============================================================================

# --- Build (prod) ---
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY Directory.Build.props Directory.Packages.props D2.slnx stylecop.json global.json NuGet.config ./
COPY .editorconfig ./
COPY public/stylecop.public.json ./public/
COPY private/services/Directory.Build.targets ./private/services/
COPY public/packages/dotnet ./public/packages/dotnet
COPY private/packages/dotnet ./private/packages/dotnet
COPY private/services/audit ./private/services/audit
COPY public/contracts ./public/contracts
COPY private/contracts ./private/contracts
COPY public/tools/loggermessage-splitter ./public/tools/loggermessage-splitter

RUN dotnet restore private/services/audit/api/DcsvIo.D2.Private.Audit.Api.csproj
RUN dotnet publish private/services/audit/api/DcsvIo.D2.Private.Audit.Api.csproj \
    -c Release -o /app/publish --no-restore

# --- Prod runtime ---
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS prod
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends wget \
    && rm -rf /var/lib/apt/lists/*

ENV ASPNETCORE_URLS=
ENV DOTNET_EnableDiagnostics=0

COPY --from=build /app/publish .

EXPOSE 8080 8443

HEALTHCHECK --interval=10s --timeout=5s --retries=5 --start-period=30s \
  CMD wget -qO- http://127.0.0.1:8080/health || exit 1

ENTRYPOINT ["dotnet", "DcsvIo.D2.Private.Audit.Api.dll"]

# --- Dev: SDK + watch ---
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS dev
WORKDIR /src

RUN apt-get update \
    && apt-get install -y --no-install-recommends wget \
    && rm -rf /var/lib/apt/lists/*

ENV ASPNETCORE_URLS=
ENV DOTNET_USE_POLLING_FILE_WATCHER=1
ENV DOTNET_EnableDiagnostics=0

COPY Directory.Build.props Directory.Packages.props D2.slnx stylecop.json global.json NuGet.config ./
COPY .editorconfig ./
COPY public/stylecop.public.json ./public/
COPY private/services/Directory.Build.targets ./private/services/
COPY public/packages/dotnet ./public/packages/dotnet
COPY private/packages/dotnet ./private/packages/dotnet
COPY private/services/audit ./private/services/audit
COPY public/contracts ./public/contracts
COPY private/contracts ./private/contracts
COPY public/tools/loggermessage-splitter ./public/tools/loggermessage-splitter

RUN dotnet restore private/services/audit/api/DcsvIo.D2.Private.Audit.Api.csproj

EXPOSE 8080 8443

HEALTHCHECK --interval=10s --timeout=5s --retries=5 --start-period=60s \
  CMD wget -qO- http://127.0.0.1:8080/health || exit 1

ENTRYPOINT ["dotnet", "watch", "run", "--project", "private/services/audit/api/DcsvIo.D2.Private.Audit.Api.csproj", "--no-launch-profile"]
