# =============================================================================
# .env.secrets.example — D2-WORX secret values (template)
#
# Real secrets go in .env.secrets (gitignored + Claude-deny-ruled).
# This file is the TEMPLATE: it ships with the repo so anyone can see WHICH
# secrets exist; copy to .env.secrets and replace placeholders with real values.
#
# Workflow when adding a new secret:
#   1. Add the env var here with a clear placeholder
#   2. Update infra/compose/compose.yml to load it via env_file
#   3. Tell the operator to copy + set the real value in .env.secrets
#
# Caveats:
#   - .env.secrets is loaded SECOND in compose (after .env.local), so values
#     here override anything in .env.local with the same key
#   - Never put real values in this file — only placeholders
#   - Compose loading: docker compose --env-file .env.local --env-file .env.secrets
#
# Transition note: many of the entries below are legacy-shaped (auth/comms/files/
# gateway/signalr/dkron-mgr service keys etc.). They're preserved here during
# migration; service work will rename or restructure them as services come online.
# =============================================================================

# ---------- Database (Postgres) ---------------------------------------------
DB_USERNAME=postgres
DB_PASSWORD=replace_with_real_value

# ---------- Redis -----------------------------------------------------------
# (no separate username — Redis uses requirepass)
CACHE_PASSWORD=replace_with_real_value

# ---------- RabbitMQ --------------------------------------------------------
MQ_USERNAME=rabbitmq
MQ_PASSWORD=replace_with_real_value

# ---------- Object Storage (MinIO / S3-compatible) --------------------------
S3_USERNAME=minio
S3_PASSWORD=replace_with_real_value

# ---------- pgAdmin (DB admin UI) -------------------------------------------
DBA_EMAIL=admin@example.com
DBA_PASSWORD=replace_with_real_value

# ---------- Grafana (observability admin) -----------------------------------
OTEL_USERNAME=admin
OTEL_PASSWORD=replace_with_real_value

# Portainer admin — bcrypt hash of the admin password.
# Generate with: docker run --rm httpd:2.4-alpine htpasswd -nbB admin "YourPassword" | cut -d: -f2
# Then paste the output hash below, doubling every $ sign (e.g. $2y$ → $$2y$$).
# Docker Compose .env files interpret $ as variable references — $$ escapes to literal $.
PORTAINER_ADMIN_PASSWORD_HASH=$$2y$$05$$REPLACE_ME_WITH_YOUR_BCRYPT_HASH

# ---------- Connection URLs (embedded credentials) --------------------------
# These URLs include secret values inline — they live here, not in .env.local.
#
# Host-side shape uses localhost + published ports (tests, tools, IDE).
# Compose multiproc (d2-edge / d2-audit) REWRITES Redis / RabbitMQ / KeyCustodian
# DB hosts to Docker DNS from DB_USERNAME / DB_PASSWORD / CACHE_PASSWORD /
# MQ_* — do not expect containers to use the localhost hosts below.
#
# Password characters that are special in URLs (e.g. @ : / #) must be
# percent-encoded in these URL fields when used host-side.
REDIS_URL=redis://:replace_with_real_cache_password@localhost:6379
RABBITMQ_URL=amqp://replace_with_real_mq_user:replace_with_real_mq_password@localhost:5672

# Per-service DATABASE_URLs. Canonical PG name = d2-{domain} (e.g. d2-keycustodian,
# d2-auth, d2-files). Legacy d2-services-* names remain until those services rebuild.
# Host port 54320 is the published Postgres port; containers use d2-postgres:5432.

# KeyCustodian — d2-keycustodian. REQUIRED for Edge multiproc (Compose rewrite uses
# DB_USERNAME/DB_PASSWORD + KEYCUSTODIAN_DB_NAME; host tooling uses this URL as-is).
# Migrator creates the DB on first boot (role needs CREATEDB).
KEYCUSTODIAN_DATABASE_URL=postgresql://replace_with_real_db_user:replace_with_real_db_password@localhost:54320/d2-keycustodian

# ---------- Edge + Audit multiproc (secrets wiring checklist) ----------------
# No new third-party API tokens for the multiproc stub. Required material:
#
#   1. REDIS_URL + CACHE_PASSWORD — Edge and Audit AuthConfigure/tiered cache
#   2. RABBITMQ_URL + MQ_USERNAME/MQ_PASSWORD — Edge (KC announcer / bus)
#   3. KEYCUSTODIAN_DATABASE_URL + DB_USERNAME/DB_PASSWORD — Edge KC store
#   4. PORTAINER_ADMIN_PASSWORD_HASH — only if you run Portainer (host 9443)
#
# NOT secrets (live in .env.local): EDGE_* ports, IssuerBaseUrl, AUDIT_GRPC__ADDRESS,
# Kestrel PEM *paths*, TrustAnchor paths.
#
# File material (gitignored secrets/ — never put PEM bodies in this file):
#   tools/scripts/gen-dev-keys.sh populates:
#     secrets/keycustodian/{root.key,ca-root.crt,ca-intermediate.crt,.key,...}
#     secrets/listen/{edge-server,audit-server}.{crt,key}
# Compose bind-mounts those into the containers at the paths in .env.local.

# ---------- Third-party API credentials -------------------------------------

# IPinfo — WhoIs / geolocation lookups (Edge geolocation)
# Get a free token at https://ipinfo.io/signup
GEO_INFRA__IPINFOACCESSTOKEN=replace_with_real_ipinfo_token

# Resend — Email provider (D2.Courier email)
# Sign up at https://resend.com/signup (100 emails/day free)
RESEND_API_KEY=re_replace_with_real_api_key
# RFC 5322 format: "Display Name <address>" — must be verified on the Resend account
RESEND_FROM_ADDRESS=Your App <onboarding@resend.dev>

# Twilio — SMS provider (D2.Courier SMS fallback channel)
# Sign up at https://www.twilio.com/try-twilio ($15 credit)
TWILIO_ACCOUNT_SID=AC_replace_with_real_account_sid
TWILIO_AUTH_TOKEN=replace_with_real_auth_token
TWILIO_PHONE_NUMBER=+1replace_with_real_twilio_number

# ---------- S3 credentials --------------------------------------------------
# D2.Files connects to MinIO/SeaweedFS using these credentials.
FILES_S3_ACCESS_KEY=replace_with_real_minio_root_user
FILES_S3_SECRET_KEY=replace_with_real_minio_root_password

# ---------- Inter-service auth secrets --------------------------------------
# Services do NOT authenticate to each other with static API keys. Edge mints
# one internal transaction-token at the boundary; each downstream hop forwards it
# unchanged + re-validates it, and mTLS (per-workload certificates issued by
# KeyCustodian as the internal CA) authenticates the calling service. Workload
# identity comes from the mTLS certificate, not an OAuth client_credentials token.
#
# RFC 8693 token exchange backs the Edge boundary mint + deliberate exceptions
# (cross-trust-domain, narrowing, async scope reduction, impersonation); where an
# exchange needs a client secret, KeyCustodian (a module within Edge) issues it
# per registered client.
#
# Pattern: {SERVICE}_OAUTH_CLIENT_SECRET=...
# Edge multiproc stub uses KeyCustodian-issued workload certs + forwarded JWT on the
# Audit bridge (no static inter-service API keys). Product OAuth client_secret rows
# land when the Auth module registers clients — leave empty until then.
