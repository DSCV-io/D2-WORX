# =============================================================================
# .env.secrets.example — D2-WORX secret values (template)
#
# Real secrets go in .env.secrets (gitignored + Claude-deny-ruled per V2.md §12).
# This file is the TEMPLATE: it ships with the repo so anyone can see WHICH
# secrets exist; copy to .env.secrets and replace placeholders with real values.
#
# Workflow when adding a new secret:
#   1. Add the env var here with a clear placeholder
#   2. Update infra/compose/compose.yml to load it via env_file
#   3. Tell the operator to copy + set the real value in .env.secrets
#
# Caveats:
#   - .env.secrets is loaded SECOND in compose (after .env.local), so values
#     here override anything in .env.local with the same key
#   - Never put real values in this file — only placeholders
#   - Compose loading: docker compose --env-file .env.local --env-file .env.secrets
# =============================================================================

# ---------- Database ---------------------------------------------------------
DB_PASSWORD=replace_with_real_value

# ---------- Redis ------------------------------------------------------------
CACHE_PASSWORD=replace_with_real_value

# ---------- RabbitMQ ---------------------------------------------------------
MQ_PASSWORD=replace_with_real_value

# ---------- Object Storage (MinIO / S3-compatible) --------------------------
S3_PASSWORD=replace_with_real_value

# ---------- Dev tooling credentials -----------------------------------------
DBA_PASSWORD=replace_with_real_value
OTEL_PASSWORD=replace_with_real_value

# Portainer admin — bcrypt hash, generate with:
#   docker run --rm portainer/helper-reset-password
PORTAINER_ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash

# ---------- Third-party API credentials -------------------------------------
# Added per service phase as integrations land per V2.md §4
#
# Twilio (SMS — Phase 5 D2.Courier)
# TWILIO_AUTH_TOKEN=replace_with_real_value
#
# Resend (email — Phase 5 D2.Courier)
# RESEND_API_KEY=replace_with_real_value
#
# IPinfo (WhoIs lookups — Phase 3 Edge)
# IPINFO_TOKEN=replace_with_real_value

# ---------- OAuth service-identity client secrets ---------------------------
# Generated by KeyCustodian per V2.md §5.4 — populated when each .NET service
# registers as an OAuth client at Edge during its phase rollout.
#
# Pattern: {SERVICE}_OAUTH_CLIENT_SECRET=...
