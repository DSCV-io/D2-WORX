# (they include credentials inline). See .env.secrets.example.

# ===========================================
# gRPC Service Addresses [DOCKER OVERRIDE]
# ===========================================
# Bare host:port — consumers prepend http://. Docker Compose overrides with container DNS.
GEO_GRPC_ADDRESS=localhost:5138
AUTH_GRPC_ADDRESS=localhost:5101
COMMS_GRPC_ADDRESS=localhost:5200
SIGNALR_GRPC_ADDRESS=localhost:5401

# ===========================================
# Service Names
# ===========================================
GEO_SERVICE_NAME=d2-geo
AUTH_SERVICE_NAME=d2-auth
COMMS_SERVICE_NAME=d2-comms
GATEWAY_SERVICE_NAME=d2-gateway
DKRON_MGR_SERVICE_NAME=d2-dkron-mgr
SVELTEKIT_SERVICE_NAME=d2-sveltekit

# ===========================================
# Geo Service
# ===========================================
GEO_PORT=5138
# Endpoint for Alloy to scrape Prometheus metrics from Geo (inside Docker network).
GEO_METRICS_ENDPOINT=d2-geo:5138

# GEO_DATABASE_URL lives in .env.secrets.
# GEO_INFRA__IPINFOACCESSTOKEN lives in .env.secrets (third-party API token).
GEO_APP__JOBLOCKTTLSECONDS=300
GEO_APP__WHOISRETENTIONDAYS=180

# ===========================================
# Auth Service
# ===========================================
# AUTH_DATABASE_URL lives in .env.secrets.
# Frontend URL — BetterAuth uses this to generate email verification/reset links.
# Must be the SvelteKit URL since it proxies /api/auth/* to the auth service.
AUTH_BASE_URL=http://localhost:5173
# Public URL for email links (verification, password reset). Falls back to AUTH_BASE_URL if not set.
# Set to your public domain in production (e.g., https://your-domain.example.com)
AUTH_EMAIL_BASE_URL=http://localhost:5173
AUTH_CORS_ORIGINS__0=http://localhost:5173
AUTH_CORS_ORIGINS__1=https://your-domain.example.com
AUTH_JWT_ISSUER=d2-worx
AUTH_JWT_AUDIENCE=d2-services
AUTH_HTTP_PORT=5100
AUTH_GRPC_PORT=5101

AUTH_APP__SIGNINEVENTRETENTIONDAYS=90
AUTH_APP__INVITATIONRETENTIONDAYS=7
AUTH_APP__JOBLOCKTTLMS=300000

# ===========================================
# Comms Service
# ===========================================
# COMMS_DATABASE_URL lives in .env.secrets.
COMMS_GRPC_PORT=5200

COMMS_APP__DELETEDMESSAGERETENTIONDAYS=90
COMMS_APP__DELIVERYHISTORYRETENTIONDAYS=365
COMMS_APP__JOBLOCKTTLMS=300000
# Brand text shown in automated email footers (e.g., "This is an automated message from {text}.")
COMMS_APP__EMAILFOOTERTEXT=Your App

# Resend, Twilio credentials (including RESEND_FROM_ADDRESS + TWILIO_PHONE_NUMBER) live in .env.secrets.
# Grouped there with their account credentials so per-account identity stays bundled.

# SMS provider: "twilio" or "mock". Mock appends each message to JSONL log at
# COMMS_SMS_MOCK_LOG_PATH (default /app/.dev-data/sms.jsonl → host: ./.dev-data/sms.jsonl).
# Use mock until Twilio TFN/10DLC registration is approved (2-5 weeks).
COMMS_SMS_PROVIDER=mock
# COMMS_SMS_MOCK_LOG_PATH=/app/.dev-data/sms.jsonl  # optional override

# ===========================================
# KeyCustodian (Edge module)
# ===========================================
# KeyCustodian is a module within Edge — its config rides the Edge host. The
# database connection (KEYCUSTODIAN_DATABASE_URL) lives in .env.secrets.
#
# App section — rotation policy + generated-key sizing. The default policy applies
# to every domain without an override; per-domain overrides key on the domain wire
# value (e.g. POLICIES__JWKS-SIGNING__CADENCE). Durations are .NET TimeSpan
# (d.hh:mm:ss).
KEYCUSTODIAN_APP__DEFAULT__CADENCE=30.00:00:00
KEYCUSTODIAN_APP__DEFAULT__GRACE=7.00:00:00
KEYCUSTODIAN_APP__DEFAULT__SMOKESOAK=01:00:00
# Per-domain override example (JWKS signing rotates every 90 days):
KEYCUSTODIAN_APP__POLICIES__JWKS-SIGNING__CADENCE=90.00:00:00
KEYCUSTODIAN_APP__POLICIES__JWKS-SIGNING__GRACE=7.00:00:00
KEYCUSTODIAN_APP__POLICIES__JWKS-SIGNING__SMOKESOAK=01:00:00
# mTLS CA rotation overrides — the intermediate (~1y validity) rotates well before
# expiry; the root (~10y) rarely. These make the CA cadence explicit instead of the
# silent 30-day default. Cadence must be >= grace + smoke-soak.
KEYCUSTODIAN_APP__POLICIES__MTLS-CA-INTERMEDIATE__CADENCE=180.00:00:00
KEYCUSTODIAN_APP__POLICIES__MTLS-CA-INTERMEDIATE__GRACE=30.00:00:00
KEYCUSTODIAN_APP__POLICIES__MTLS-CA-INTERMEDIATE__SMOKESOAK=01:00:00
KEYCUSTODIAN_APP__POLICIES__MTLS-CA-ROOT__CADENCE=3000.00:00:00
KEYCUSTODIAN_APP__POLICIES__MTLS-CA-ROOT__GRACE=90.00:00:00
KEYCUSTODIAN_APP__POLICIES__MTLS-CA-ROOT__SMOKESOAK=01:00:00
KEYCUSTODIAN_APP__RSAKEYSIZEBITS=2048
KEYCUSTODIAN_APP__SECRETLENGTHBYTES=64
# mTLS certificate validity windows (.NET TimeSpan). Leaf < Intermediate < Root is
# enforced at startup. Defaults: root ~10y, intermediate ~1y, leaf 24h.
KEYCUSTODIAN_APP__ROOTCAVALIDITY=3650.00:00:00
KEYCUSTODIAN_APP__INTERMEDIATECAVALIDITY=365.00:00:00
KEYCUSTODIAN_APP__LEAFVALIDITY=1.00:00:00
#
# Infra section — the root-key directory, the rotation tick cadence, and the
# per-command DB timeout. ROOTKEYPATH holds root.key (+ optional root-next.key) AND
# the dev mTLS CA chain ca-root.{crt,key} + ca-intermediate.{crt,key}, all generated
# by tools/scripts/gen-dev-keys.sh and seeded into keycustodian_db on startup.
KEYCUSTODIAN_INFRA__ROOTKEYPATH=/run/secrets/keycustodian
KEYCUSTODIAN_INFRA__ROTATIONCHECKINTERVAL=00:05:00
KEYCUSTODIAN_INFRA__DBCOMMANDTIMEOUTSECONDS=30

# ===========================================
# REST Gateway
# ===========================================
GATEWAY_PORT=5461
# Endpoint for Alloy to scrape Prometheus metrics from Gateway (inside Docker network).
GATEWAY_METRICS_ENDPOINT=d2-gateway:5461

GATEWAY_CORS_ORIGINS__0=http://localhost:5173
GATEWAY_CORS_ORIGINS__1=https://your-domain.example.com

# [DOCKER OVERRIDE] Compose replaces localhost → d2-auth
GATEWAY_AUTH__AUTHSERVICEBASEURL=http://localhost:5100
GATEWAY_AUTH__ISSUER=d2-worx
GATEWAY_AUTH__AUDIENCE=d2-services

# Inter-service auth: Edge mints one internal transaction-token at the boundary
# and each downstream hop forwards it unchanged + re-validates it, with mTLS
# (KeyCustodian-issued workload certificates) authenticating the calling service.
# RFC 8693 token exchange backs the boundary mint + deliberate exceptions, not a
# per-hop re-mint. No static API keys. (Forward model + mTLS designed, not yet wired.)

# ===========================================
# SignalR Real-Time Gateway
# ===========================================
SIGNALR_SERVICE_NAME=d2-signalr
SIGNALR_HTTP_PORT=5400
SIGNALR_GRPC_PORT=5401
SIGNALR_AUTH__AUTHSERVICEBASEURL=http://localhost:5100
SIGNALR_AUTH__ISSUER=d2-worx
SIGNALR_AUTH__AUDIENCE=d2-services
# Public URL — browser-reachable WebSocket endpoint (cloudflared tunnel).
SIGNALR_PUBLIC_URL=https://ws.your-domain.example.com

# ===========================================
# Files Service
# ===========================================
FILES_SERVICE_NAME=d2-files
FILES_HTTP_PORT=5300
FILES_GRPC_PORT=5301
# FILES_DATABASE_URL lives in .env.secrets.
FILES_S3_BUCKET=d2-files
FILES_S3_ENDPOINT=http://localhost:9000
# FILES_S3_ACCESS_KEY and FILES_S3_SECRET_KEY live in .env.secrets.
# Public S3 endpoint — browser-reachable URL for presigned upload URLs (cloudflared tunnel to MinIO).
# When set, presigned URLs point here instead of FILES_S3_ENDPOINT.
FILES_S3_PUBLIC_ENDPOINT=https://s3.your-domain.example.com
FILES_CORS_ORIGINS__0=http://localhost:5173
FILES_CORS_ORIGINS__1=https://your-domain.example.com
FILES_JWKS_URL=http://localhost:5100/.well-known/jwks.json
FILES_JWT_ISSUER=d2-worx
FILES_JWT_AUDIENCE=d2-services
# Inter-service auth: forward the Edge-minted internal token + re-validate it, with
# mTLS authenticating the workload — no static API keys.

# ===========================================
# Files Service — Context Key Configs
# ===========================================

# User avatars (Auth service owns — gRPC on port 5101)
FILES_CK__0__KEY=user_avatar
FILES_CK__0__UPLOAD_RESOLUTION=jwt_owner
# Avatar content is public-by-id (any signed-in user can fetch), but listing
# all of a user's historical avatars is restricted to the owner — prevents
# cross-tenant enumeration of avatar inventory.
FILES_CK__0__READ_RESOLUTION=authenticated
FILES_CK__0__LIST_RESOLUTION=jwt_owner
FILES_CK__0__CALLBACK_ADDR=d2-auth:5101
FILES_CK__0__CATEGORY__0=image
FILES_CK__0__MAX_SIZE_BYTES=5242880
FILES_CK__0__VARIANT__0__NAME=thumb
FILES_CK__0__VARIANT__0__MAX_DIM=64
FILES_CK__0__VARIANT__1__NAME=small
FILES_CK__0__VARIANT__1__MAX_DIM=128
FILES_CK__0__VARIANT__2__NAME=medium
FILES_CK__0__VARIANT__2__MAX_DIM=256
FILES_CK__0__VARIANT__3__NAME=original

# Org logos (Auth service owns — gRPC on port 5101)
FILES_CK__1__KEY=org_logo
FILES_CK__1__UPLOAD_RESOLUTION=jwt_org
FILES_CK__1__READ_RESOLUTION=jwt_org
FILES_CK__1__CALLBACK_ADDR=d2-auth:5101
FILES_CK__1__CATEGORY__0=image
FILES_CK__1__MAX_SIZE_BYTES=10485760
FILES_CK__1__VARIANT__0__NAME=thumb
FILES_CK__1__VARIANT__0__MAX_DIM=64
FILES_CK__1__VARIANT__1__NAME=medium
FILES_CK__1__VARIANT__1__MAX_DIM=512
FILES_CK__1__VARIANT__2__NAME=original

# Org documents (Auth service owns — gRPC on port 5101)
FILES_CK__2__KEY=org_document
FILES_CK__2__UPLOAD_RESOLUTION=jwt_org
FILES_CK__2__READ_RESOLUTION=jwt_org
FILES_CK__2__CALLBACK_ADDR=d2-auth:5101
FILES_CK__2__CATEGORY__0=document
FILES_CK__2__MAX_SIZE_BYTES=26214400
FILES_CK__2__VARIANT__0__NAME=original

# Thread attachments (Comms service owns — gRPC on port 5200)
FILES_CK__3__KEY=thread_attachment
FILES_CK__3__UPLOAD_RESOLUTION=callback
# Read-by-id is public-with-link; list of all attachments under a thread
# requires Comms to confirm the caller is a thread member.
FILES_CK__3__READ_RESOLUTION=authenticated
FILES_CK__3__LIST_RESOLUTION=callback
FILES_CK__3__CALLBACK_ADDR=d2-comms:5200
FILES_CK__3__CATEGORY__0=image
FILES_CK__3__CATEGORY__1=document
FILES_CK__3__CATEGORY__2=video
FILES_CK__3__CATEGORY__3=audio
FILES_CK__3__MAX_SIZE_BYTES=26214400
FILES_CK__3__VARIANT__0__NAME=thumb
FILES_CK__3__VARIANT__0__MAX_DIM=150
FILES_CK__3__VARIANT__1__NAME=preview
FILES_CK__3__VARIANT__1__MAX_DIM=800
FILES_CK__3__VARIANT__2__NAME=original

# ===========================================
# Dkron Manager [DOCKER OVERRIDE]
# ===========================================
# Compose replaces localhost URLs → Docker DNS (d2-dkron:8080, d2-gateway:5461).
# Inter-service auth: forward the Edge-minted internal token + re-validate it, with
# mTLS authenticating the workload — no static API keys.
DKRON_MGR__DKRON_URL=http://localhost:8888
DKRON_MGR__GATEWAY_URL=http://localhost:5461
DKRON_MGR__RECONCILE_INTERVAL_MS=300000

# ===========================================
# Public Variables (readable by all services + SvelteKit browser)
# ===========================================
# Enabled BCP 47 locales. Read by all services for i18n resolution.
# SvelteKit exposes PUBLIC_* vars to the browser automatically.
PUBLIC_DEFAULT_LOCALE=en-US
PUBLIC_ENABLED_LOCALES__0=en-US
PUBLIC_ENABLED_LOCALES__1=en-CA
PUBLIC_ENABLED_LOCALES__2=en-GB
PUBLIC_ENABLED_LOCALES__3=fr-FR
PUBLIC_ENABLED_LOCALES__4=fr-CA
PUBLIC_ENABLED_LOCALES__5=es-ES
PUBLIC_ENABLED_LOCALES__6=es-MX
PUBLIC_ENABLED_LOCALES__7=de-DE
PUBLIC_ENABLED_LOCALES__8=it-IT
PUBLIC_ENABLED_LOCALES__9=ja-JP
PUBLIC_GATEWAY_URL=https://gateway.your-domain.example.com
PUBLIC_FARO_COLLECTOR_URL=https://grafana.your-domain.example.com/collect

# ===========================================
# SvelteKit / Web Client
# ===========================================
# Browser connects to Edge directly for auth state mutations (no SvelteKit
# proxy of /api/auth/*). SvelteKit BFF handles SSR + load() functions.
SVELTEKIT_PORT=5173
VITE_ALLOWED_HOSTS=localhost

# [DOCKER OVERRIDE] Compose replaces localhost URLs → Docker DNS.
SVELTEKIT_AUTH__URL=http://localhost:5100
SVELTEKIT_GATEWAY__URL=http://localhost:5461

# Files service (browser-facing)
PUBLIC_FILES_URL=https://files.your-domain.example.com

# SignalR gateway (browser-facing WebSocket)
PUBLIC_SIGNALR_URL=https://ws.your-domain.example.com

# SignalR CORS (browser connects directly for WebSocket)
SIGNALR_CORS_ORIGINS__0=http://localhost:5173
SIGNALR_CORS_ORIGINS__1=https://your-domain.example.com

# Auth service → SignalR gateway (user:updated push events)
# Inter-service auth: forward the Edge-minted internal token + re-validate it, with
# mTLS authenticating the workload — no static API key here.
AUTH_SIGNALR_GATEWAY_ADDRESS=d2-signalr:5401
