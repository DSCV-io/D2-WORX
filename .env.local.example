# D2-WORX Environment Variables
# Copy this file to .env.local and fill in your values.
# WARNING: Never commit .env.local to version control.
#
# THIS FILE IS THE SINGLE SOURCE OF TRUTH for all configuration.
# Code reads env vars with NO defaults — if a required var is missing, it crashes.
#
# Convention: SERVICE_LAYER__PROPERTY (double underscore = hierarchy separator).
# .NET AddEnvironmentVariables() auto-maps __ to : for IConfiguration binding.
# Node.js services parse the same env vars directly.
#
# DOCKER COMPOSE OVERRIDES:
# Values marked [DOCKER OVERRIDE] use localhost for host-side tooling (tests, debugger).
# docker-compose.yml `environment:` replaces these with Docker DNS names at runtime
# (e.g., localhost:54320 → d2-postgres:5432). See compose for the override mapping.

# ===========================================
# Credentials
# ===========================================
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here
DBA_EMAIL=admin@example.com
DBA_PASSWORD=your_secure_password_here
MQ_USERNAME=rabbitmq
MQ_PASSWORD=your_secure_password_here
CACHE_PASSWORD=your_secure_password_here
S3_USERNAME=minio
S3_PASSWORD=your_secure_password_here
OTEL_USERNAME=admin
OTEL_PASSWORD=your_secure_password_here

# ===========================================
# Observability — Shared Config
# ===========================================
# Base path for observability config bind mounts (legacy — compose uses relative paths).
OBSERVABILITY_CONFIG_PATH=../../../../observability
OTEL_CLUSTER_NAME=d2-local-dev
OTEL_ENVIRONMENT=Development

# ===========================================
# MinIO — S3 Compatible Object Storage
# ===========================================
MINIO_NAME=d2-minio
MINIO_IMAGE=minio/minio
MINIO_TAG=RELEASE.2025-09-07T16-13-09Z
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_VOLUME=d2-minio-data
MINIO_TOKENS_VOLUME=d2-minio-tokens
MINIO_BUCKET_LOKI=loki-logs
MINIO_BUCKET_TEMPO=tempo-traces
MINIO_BUCKET_MIMIR_BLOCKS=mimir-blocks
MINIO_BUCKET_MIMIR_RULER=mimir-ruler
MINIO_BUCKET_UPLOADS=minio-uploads
MINIO_BUCKET_FILES=d2-files

# MinIO Client (init buckets)
MINIO_INIT_NAME=d2-minio-init
MINIO_MC_IMAGE=minio/mc
MINIO_MC_TAG=RELEASE.2025-08-13T08-35-41Z

# ===========================================
# Loki — Log Aggregation
# ===========================================
LOKI_NAME=d2-loki
LOKI_IMAGE=grafana/loki
LOKI_TAG=3.5.10
LOKI_HTTP_PORT=3100
LOKI_GRPC_PORT=9095
LOKI_VOLUME=d2-loki-data

# ===========================================
# Tempo — Distributed Tracing
# ===========================================
TEMPO_NAME=d2-tempo
TEMPO_IMAGE=grafana/tempo
TEMPO_TAG=2.10.1
TEMPO_HTTP_PORT=3200
TEMPO_GRPC_PORT=9096
TEMPO_VOLUME=d2-tempo-data

# ===========================================
# Mimir — Metrics
# ===========================================
MIMIR_NAME=d2-mimir
MIMIR_IMAGE=grafana/mimir
MIMIR_TAG=2.17.7
MIMIR_HTTP_PORT=9009
MIMIR_GRPC_PORT=9097
MIMIR_VOLUME=d2-mimir-data

# ===========================================
# cAdvisor — Container Resource Monitoring
# ===========================================
CADVISOR_NAME=d2-cadvisor
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor
CADVISOR_TAG=v0.52.1
CADVISOR_PORT=8081

# ===========================================
# Grafana Alloy — Unified OTel Agent
# ===========================================
ALLOY_NAME=d2-alloy
ALLOY_IMAGE=grafana/alloy
ALLOY_TAG=v1.13.2
ALLOY_HTTP_PORT=12345
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
ALLOY_VOLUME=d2-alloy-data
# Comma-separated origins allowed to send Faro telemetry (browser → Alloy).
FARO_CORS_ORIGINS=http://localhost:5173,https://your-domain.example.com
FARO_RECEIVER_PORT=12347

# ===========================================
# Grafana — Visualization
# ===========================================
GRAFANA_NAME=d2-grafana
GRAFANA_IMAGE=grafana/grafana
GRAFANA_TAG=12.4.0
GRAFANA_PORT=3000
GRAFANA_VOLUME=d2-grafana-data
GRAFANA_COOKIE_SECURE=false
GRAFANA_COOKIE_SAMESITE=lax
GRAFANA_STRICT_TRANSPORT_SECURITY=false

# ===========================================
# PostgreSQL + pgAdmin + Exporter
# ===========================================
POSTGRES_NAME=d2-postgres
POSTGRES_TAG=18.3-trixie
POSTGRES_PORT=54320
POSTGRES_VOLUME=d2-postgres-data

PGADMIN_NAME=d2-pgadmin
PGADMIN_TAG=9.12
PGADMIN_PORT=5533

PG_EXPORTER_NAME=d2-pg-exporter
PG_EXPORTER_IMAGE=prometheuscommunity/postgres-exporter
PG_EXPORTER_TAG=v0.19.1
PG_EXPORTER_PORT=9187

# ===========================================
# Redis + RedisInsight + Exporter
# ===========================================
REDIS_NAME=d2-redis
REDIS_TAG=8.2.4-bookworm
REDIS_PORT=6379
REDIS_VOLUME=d2-redis-data

REDISINSIGHT_NAME=d2-redisinsight
REDISINSIGHT_TAG=2.70.1
REDISINSIGHT_PORT=5540
REDISINSIGHT_VOLUME=d2-redisinsight-data

REDIS_EXPORTER_NAME=d2-redis-exporter
REDIS_EXPORTER_IMAGE=oliver006/redis_exporter
REDIS_EXPORTER_TAG=v1.80.1
REDIS_EXPORTER_PORT=9121

# ===========================================
# RabbitMQ — Message Broker
# ===========================================
RABBITMQ_NAME=d2-rabbitmq
RABBITMQ_TAG=4.1.7-management
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_METRICS_PORT=15692
RABBITMQ_VOLUME=d2-rabbitmq-data

# ===========================================
# ClamAV — Malware Scanning
# ===========================================
CLAMAV_NAME=d2-clamav
CLAMAV_IMAGE=clamav/clamav
CLAMAV_TAG=1.4
CLAMAV_PORT=3310
CLAMAV_VOLUME=d2-clamav-data

# ===========================================
# Dkron — Distributed Job Scheduler
# ===========================================
DKRON_NAME=d2-dkron
DKRON_IMAGE=dkron/dkron
DKRON_TAG=4.0.9
DKRON_DASHBOARD_PORT=8888
DKRON_VOLUME=d2-dkron-data

# ===========================================
# Portainer — Container Management UI
# ===========================================
PORTAINER_IMAGE=portainer/portainer-ce
PORTAINER_TAG=2.39.0
# Bcrypt hash of the admin password for Portainer web UI.
# Generate with: docker run --rm httpd:2.4-alpine htpasswd -nbB admin "YourPassword" | cut -d: -f2
# Then paste the output hash below, doubling every $ sign (e.g. $2y$ → $$2y$$).
# Docker Compose .env files interpret $ as variable references — $$ escapes to literal $.
PORTAINER_ADMIN_PASSWORD_HASH=$$2y$$05$$REPLACE_ME_WITH_YOUR_BCRYPT_HASH

# ===========================================
# OTel Endpoints
# ===========================================
OTLP_HTTP_ENDPOINT=http://localhost:4318
LOKI_PUSH_ENDPOINT=http://localhost:3100

# ===========================================
# Database Names
# ===========================================
# When true, .NET services apply EF Core migrations on startup (local dev).
AUTO_MIGRATE=true

GEO_DB_NAME=d2-services-geo
AUTH_DB_NAME=d2-services-auth
COMMS_DB_NAME=d2-services-comms
FILES_DB_NAME=d2-services-files

# ===========================================
# Connection URLs [DOCKER OVERRIDE]
# ===========================================
# Host-side defaults for tests/debugger. Docker Compose overrides with container DNS.
# Port 54320 = external PG port from POSTGRES_PORT above (internal = 5432).
REDIS_URL=redis://:your_cache_password@localhost:6379
RABBITMQ_URL=amqp://your_mq_user:your_mq_password@localhost:5672

# ===========================================
# gRPC Service Addresses [DOCKER OVERRIDE]
# ===========================================
# Bare host:port — consumers prepend http://. Docker Compose overrides with container DNS.
GEO_GRPC_ADDRESS=localhost:5138
AUTH_GRPC_ADDRESS=localhost:5101
COMMS_GRPC_ADDRESS=localhost:5200
SIGNALR_GRPC_ADDRESS=localhost:5401

# ===========================================
# Service Names
# ===========================================
GEO_SERVICE_NAME=d2-geo
AUTH_SERVICE_NAME=d2-auth
COMMS_SERVICE_NAME=d2-comms
GATEWAY_SERVICE_NAME=d2-gateway
DKRON_MGR_SERVICE_NAME=d2-dkron-mgr
SVELTEKIT_SERVICE_NAME=d2-sveltekit

# ===========================================
# Geo Service
# ===========================================
GEO_PORT=5138
# Endpoint for Alloy to scrape Prometheus metrics from Geo (inside Docker network).
GEO_METRICS_ENDPOINT=d2-geo:5138

# [DOCKER OVERRIDE] Compose replaces localhost:54320 → d2-postgres:5432
GEO_DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:54320/d2-services-geo

# IPInfo API token for WhoIs/geolocation lookups
# Get a free token at https://ipinfo.io/signup
GEO_INFRA__IPINFOACCESSTOKEN=your_ipinfo_token_here

# API key → context key mappings
# Format: GEO_APP__APIKEYMAPPINGS__<api-key>__<index>=<context-key>
GEO_APP__APIKEYMAPPINGS__your_auth_api_key_here__0=auth_org_contact
GEO_APP__APIKEYMAPPINGS__your_auth_api_key_here__1=auth_user
GEO_APP__APIKEYMAPPINGS__your_auth_api_key_here__2=auth_org_invitation
GEO_APP__APIKEYMAPPINGS__your_comms_api_key_here__0=auth_org_contact
GEO_APP__APIKEYMAPPINGS__your_comms_api_key_here__1=auth_user
GEO_APP__APIKEYMAPPINGS__your_files_geo_api_key_here__0=_files
GEO_APP__APIKEYMAPPINGS__your_sveltekit_geo_key_here__0=_sveltekit
GEO_APP__APIKEYMAPPINGS__your_gateway_api_key_here__0=_gateway
GEO_APP__JOBLOCKTTLSECONDS=300
GEO_APP__WHOISRETENTIONDAYS=180

# Geo Client — Auth Service
AUTH_GEO_CLIENT__APIKEY=your_api_key_here

# Geo Client — Comms Service
COMMS_GEO_CLIENT__APIKEY=your_api_key_here

# ===========================================
# Auth Service
# ===========================================
# [DOCKER OVERRIDE] Compose replaces localhost:54320 → d2-postgres:5432
AUTH_DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:54320/d2-services-auth
# Frontend URL — BetterAuth uses this to generate email verification/reset links.
# Must be the SvelteKit URL since it proxies /api/auth/* to the auth service.
AUTH_BASE_URL=http://localhost:5173
# Public URL for email links (verification, password reset). Falls back to AUTH_BASE_URL if not set.
# Set to your public domain in production (e.g., https://t.dcsv.io)
AUTH_EMAIL_BASE_URL=http://localhost:5173
AUTH_CORS_ORIGINS__0=http://localhost:5173
AUTH_CORS_ORIGINS__1=https://your-domain.example.com
AUTH_JWT_ISSUER=d2-worx
AUTH_JWT_AUDIENCE=d2-services
AUTH_HTTP_PORT=5100
AUTH_GRPC_PORT=5101
AUTH_API_KEYS__0=your_gateway_api_key_here
AUTH_API_KEYS__1=your_sveltekit_auth_key_here
AUTH_API_KEYS__2=your_files_callback_key_here

AUTH_APP__SIGNINEVENTRETENTIONDAYS=90
AUTH_APP__INVITATIONRETENTIONDAYS=7
AUTH_APP__JOBLOCKTTLMS=300000

# ===========================================
# Comms Service
# ===========================================
# [DOCKER OVERRIDE] Compose replaces localhost:54320 → d2-postgres:5432
COMMS_DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:54320/d2-services-comms
COMMS_API_KEYS__0=your_auth_comms_api_key_here
COMMS_API_KEYS__1=your_gateway_api_key_here
COMMS_API_KEYS__2=your_files_callback_key_here
COMMS_GRPC_PORT=5200

COMMS_APP__DELETEDMESSAGERETENTIONDAYS=90
COMMS_APP__DELIVERYHISTORYRETENTIONDAYS=365
COMMS_APP__JOBLOCKTTLMS=300000
# Brand text shown in automated email footers (e.g., "This is an automated message from {text}.")
COMMS_APP__EMAILFOOTERTEXT=Your App

# Resend — Email provider
# Sign up at https://resend.com/signup (100 emails/day free)
RESEND_API_KEY=re_your_api_key_here
# RFC 5322 format: "Display Name <address>" for branded sender metadata
RESEND_FROM_ADDRESS=Your App <onboarding@resend.dev>

# Twilio — SMS provider (optional, SMS is a fallback channel)
# Sign up at https://www.twilio.com/try-twilio ($15 credit)
TWILIO_ACCOUNT_SID=AC_your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1your_twilio_number_here

# ===========================================
# REST Gateway
# ===========================================
GATEWAY_PORT=5461
# Endpoint for Alloy to scrape Prometheus metrics from Gateway (inside Docker network).
GATEWAY_METRICS_ENDPOINT=d2-gateway:5461

GATEWAY_CORS_ORIGINS__0=http://localhost:5173
# GATEWAY_CORS_ORIGINS__1=https://your-domain.example.com

# [DOCKER OVERRIDE] Compose replaces localhost → d2-auth
GATEWAY_AUTH__AUTHSERVICEBASEURL=http://localhost:5100
GATEWAY_AUTH__ISSUER=d2-worx
GATEWAY_AUTH__AUDIENCE=d2-services

GATEWAY_SERVICEKEY__VALIDKEYS__0=your_service_key_here
GATEWAY_SERVICEKEY__VALIDKEYS__1=your_dkron_service_key_here

GATEWAY_AUTH_GRPC_API_KEY=your_gateway_api_key_here
GATEWAY_GEO_GRPC_API_KEY=your_gateway_api_key_here
GATEWAY_COMMS_GRPC_API_KEY=your_gateway_api_key_here
GATEWAY_FILES_GRPC_API_KEY=your_gateway_api_key_here

# ===========================================
# SignalR Real-Time Gateway
# ===========================================
SIGNALR_SERVICE_NAME=d2-signalr
SIGNALR_HTTP_PORT=5400
SIGNALR_GRPC_PORT=5401
SIGNALR_AUTH__AUTHSERVICEBASEURL=http://localhost:5100
SIGNALR_AUTH__ISSUER=d2-worx
SIGNALR_AUTH__AUDIENCE=d2-services
SIGNALR_SERVICEKEY__VALIDKEYS__0=your_signalr_api_key_here
# Public URL — browser-reachable WebSocket endpoint.
# Set to your tunnel/proxy URL for remote access. Leave unset for local-only dev.
# SIGNALR_PUBLIC_URL=https://ws.your-domain.example.com

# ===========================================
# Files Service
# ===========================================
FILES_SERVICE_NAME=d2-files-service
FILES_HTTP_PORT=5300
FILES_GRPC_PORT=5301
# [DOCKER OVERRIDE] Compose replaces localhost:54320 → d2-postgres:5432
FILES_DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:54320/d2-services-files
FILES_S3_BUCKET=d2-files
FILES_S3_ENDPOINT=http://localhost:9000
FILES_S3_ACCESS_KEY=your_minio_root_user
FILES_S3_SECRET_KEY=your_minio_root_password
# Public S3 endpoint — browser-reachable URL for presigned upload URLs.
# When using a tunnel (cloudflared, ngrok, etc.) to expose MinIO publicly,
# set this to the tunnel URL. Presigned PUT URLs will point here instead
# of FILES_S3_ENDPOINT. Leave unset for local-only development.
# FILES_S3_PUBLIC_ENDPOINT=https://s3.your-domain.example.com
FILES_CORS_ORIGINS__0=http://localhost:5173
# FILES_CORS_ORIGINS__1=https://your-domain.example.com
FILES_API_KEYS__0=your_files_api_key_here
FILES_JWKS_URL=http://localhost:5100/api/auth/jwks
FILES_JWT_ISSUER=d2-worx
FILES_JWT_AUDIENCE=d2-services
# Geo client — request enrichment + WhoIs lookup
FILES_GEO_CLIENT__APIKEY=your_files_geo_api_key_here
# Outbound gRPC API keys — callbacks to owning services (Auth/Comms) and SignalR Gateway
FILES_CALLBACK_API_KEY=your_files_callback_key_here
FILES_SIGNALR_API_KEY=your_signalr_api_key_here

# ===========================================
# Files Service — Context Key Configs
# ===========================================

# User avatars (Auth service owns — gRPC on port 5101)
FILES_CK__0__KEY=user_avatar
FILES_CK__0__UPLOAD_RESOLUTION=jwt_owner
FILES_CK__0__READ_RESOLUTION=authenticated
FILES_CK__0__CALLBACK_ADDR=d2-auth:5101
FILES_CK__0__CATEGORY__0=image
FILES_CK__0__MAX_SIZE_BYTES=5242880
FILES_CK__0__VARIANT__0__NAME=thumb
FILES_CK__0__VARIANT__0__MAX_DIM=64
FILES_CK__0__VARIANT__1__NAME=small
FILES_CK__0__VARIANT__1__MAX_DIM=128
FILES_CK__0__VARIANT__2__NAME=medium
FILES_CK__0__VARIANT__2__MAX_DIM=256
FILES_CK__0__VARIANT__3__NAME=original

# Org logos (Auth service owns — gRPC on port 5101)
FILES_CK__1__KEY=org_logo
FILES_CK__1__UPLOAD_RESOLUTION=jwt_org
FILES_CK__1__READ_RESOLUTION=jwt_org
FILES_CK__1__CALLBACK_ADDR=d2-auth:5101
FILES_CK__1__CATEGORY__0=image
FILES_CK__1__MAX_SIZE_BYTES=10485760
FILES_CK__1__VARIANT__0__NAME=thumb
FILES_CK__1__VARIANT__0__MAX_DIM=64
FILES_CK__1__VARIANT__1__NAME=medium
FILES_CK__1__VARIANT__1__MAX_DIM=512
FILES_CK__1__VARIANT__2__NAME=original

# Org documents (Auth service owns — gRPC on port 5101)
FILES_CK__2__KEY=org_document
FILES_CK__2__UPLOAD_RESOLUTION=jwt_org
FILES_CK__2__READ_RESOLUTION=jwt_org
FILES_CK__2__CALLBACK_ADDR=d2-auth:5101
FILES_CK__2__CATEGORY__0=document
FILES_CK__2__MAX_SIZE_BYTES=26214400
FILES_CK__2__VARIANT__0__NAME=original

# Thread attachments (Comms service owns — gRPC on port 5200)
FILES_CK__3__KEY=thread_attachment
FILES_CK__3__UPLOAD_RESOLUTION=callback
FILES_CK__3__READ_RESOLUTION=authenticated
FILES_CK__3__CALLBACK_ADDR=d2-comms:5200
FILES_CK__3__CATEGORY__0=image
FILES_CK__3__CATEGORY__1=document
FILES_CK__3__CATEGORY__2=video
FILES_CK__3__CATEGORY__3=audio
FILES_CK__3__MAX_SIZE_BYTES=26214400
FILES_CK__3__VARIANT__0__NAME=thumb
FILES_CK__3__VARIANT__0__MAX_DIM=150
FILES_CK__3__VARIANT__1__NAME=preview
FILES_CK__3__VARIANT__1__MAX_DIM=800
FILES_CK__3__VARIANT__2__NAME=original

# ===========================================
# Dkron Manager [DOCKER OVERRIDE]
# ===========================================
# Compose replaces localhost URLs → Docker DNS (d2-dkron:8080, d2-gateway:5461).
DKRON_MGR__DKRON_URL=http://localhost:8888
DKRON_MGR__GATEWAY_URL=http://localhost:5461
DKRON_MGR__SERVICE_KEY=your_dkron_service_key_here
DKRON_MGR__RECONCILE_INTERVAL_MS=300000

# ===========================================
# Public Variables (readable by all services + SvelteKit browser)
# ===========================================
# Enabled BCP 47 locales. Read by all services for i18n resolution.
# SvelteKit exposes PUBLIC_* vars to the browser automatically.
PUBLIC_DEFAULT_LOCALE=en-US
PUBLIC_ENABLED_LOCALES__0=en-US
PUBLIC_ENABLED_LOCALES__1=en-CA
PUBLIC_ENABLED_LOCALES__2=en-GB
PUBLIC_ENABLED_LOCALES__3=fr-FR
PUBLIC_ENABLED_LOCALES__4=fr-CA
PUBLIC_ENABLED_LOCALES__5=es-ES
PUBLIC_ENABLED_LOCALES__6=es-MX
PUBLIC_ENABLED_LOCALES__7=de-DE
PUBLIC_ENABLED_LOCALES__8=it-IT
PUBLIC_ENABLED_LOCALES__9=ja-JP
PUBLIC_GATEWAY_URL=http://localhost:5461
PUBLIC_FARO_COLLECTOR_URL=http://localhost:12347/collect

# ===========================================
# SvelteKit / Web Client
# ===========================================
SVELTEKIT_PORT=5173
VITE_ALLOWED_HOSTS=localhost

SVELTEKIT_GEO_CLIENT__APIKEY=your_sveltekit_geo_key_here
# [DOCKER OVERRIDE] Compose replaces localhost URLs → Docker DNS.
SVELTEKIT_AUTH__URL=http://localhost:5100
SVELTEKIT_AUTH__API_KEY=your_sveltekit_auth_key_here
SVELTEKIT_GATEWAY__URL=http://localhost:5461
SVELTEKIT_GATEWAY__SERVICE_KEY=your_sveltekit_service_key_here

# Files service (browser-facing) — set to tunnel URL for remote access
# PUBLIC_FILES_URL=https://files.your-domain.example.com

# SignalR gateway (browser-facing WebSocket) — set to tunnel URL for remote access
# PUBLIC_SIGNALR_URL=https://ws.your-domain.example.com

# SignalR CORS (browser connects directly for WebSocket)
SIGNALR_CORS_ORIGINS__0=http://localhost:5173
# SIGNALR_CORS_ORIGINS__1=https://your-domain.example.com

# Auth service → SignalR gateway (user:updated push events)
AUTH_SIGNALR_GATEWAY_ADDRESS=d2-signalr:5401
AUTH_SIGNALR_API_KEY=your_signalr_api_key_here
